<UserControl x:Class="Zerg.Views.HealBarsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:v="clr-namespace:Zerg.Views">
  <UserControl.Resources>
    <!-- Character, Job, then ten figures: the widths the design draws them
         at in a table 1,340 wide, as shares. The heading and every row share
         them. The Healing % column is wide enough for the small bar an
         unshaded row has beside its figure, so there is one set. -->
    <sys:String x:Key="Columns">190*,100*,104*,105*,96*,96*,115*,112*,96*,96*,104*,124*</sys:String>

    <!-- What MP Spent and HP/MP's headings tell the pointer, docked and floating. -->
    <sys:String x:Key="MpTip">Each cast's list MP cost, charged once however many people it reached. A pet's Blood Pacts are its summoner's MP. A heal that costs the player none (Chakra, a waltz, a wyvern's breath, an automaton's Cure) is left out</sys:String>
    <sys:String x:Key="PerMpTip">HP healed per MP spent, over the heals that cost MP. A cure on someone at full health heals nothing and still costs its MP</sys:String>
    <sys:String x:Key="OvercureTip">What the cures would have healed past what their targets were missing, estimated from the cures alone: one that healed less than its caster's base for it was cut short by its target's HP, and is charged the rest of that base. One on a day or weather amount, or doubled by Divine Seal, healed whole</sys:String>
    <sys:String x:Key="OvercurePctTip">Overcure out of what those cures would have healed whole. A heal with no base (cast once, or never the same twice) has no overcure, and what it healed is left out</sys:String>

    <!-- The strip: Character, then a column for each of the table's (the
         job's nothing wide), as the damage card's strip is (Views/
         BarsCard.xaml says how its columns are worked out). -->
    <sys:String x:Key="StripColumns">1*110,0,72,52,56,56,56,72,56,64,60,64</sys:String>
    <sys:String x:Key="StripBarColumns">1*110,0,72,96,56,56,56,72,56,64,60,64</sys:String>
    <Style x:Key="Strip" TargetType="v:Cells">
      <Setter Property="Widths" Value="{StaticResource StripColumns}"/>
      <Style.Triggers>
        <Trigger Property="v:Shading.Characters" Value="False">
          <Setter Property="Widths" Value="{StaticResource StripBarColumns}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- The columns it has no room for go, the last standing first. -->
    <Style x:Key="StripRoom" TargetType="StackPanel">
      <Setter Property="v:ColumnSet.Fit" Value="{StaticResource StripColumns}"/>
      <Setter Property="v:ColumnSet.FitMargin" Value="6"/>
      <Style.Triggers>
        <Trigger Property="v:Shading.Characters" Value="False">
          <Setter Property="v:ColumnSet.Fit" Value="{StaticResource StripBarColumns}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- A column's heading in the strip: small capitals, set against the
         column's right-hand end as its figures are. -->
    <Style x:Key="StripHead" TargetType="v:Caps" BasedOn="{StaticResource GroupCaps}">
      <Setter Property="Tracking" Value="0.6"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Margin" Value="4,0,2,0"/>
    </Style>
    <Style x:Key="StripCell" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Padding" Value="4,0,2,0"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
      <Style.Triggers>
        <!-- Nothing to measure: a dash, in the quietest ink. -->
        <Trigger Property="Text" Value="&#x2014;">
          <Setter Property="Foreground" Value="{DynamicResource Text4Brush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- The job beside the name: quieter than the name (and gone where
         there is none to show, as any badge). -->
    <Style x:Key="StripJob" TargetType="TextBlock" BasedOn="{StaticResource Badge}">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
    </Style>

    <!-- A row of the docked table, in either tab, as the Damage section's
         Overview draws one (Views/BarsCard.xaml, ActorLine): a heading (a
         caster, or By target a target, the person healed) or a row under
         one. A heading is pressed to fold what is under it and wears a
         caret that says which way it is; a target's heading is on the
         raised surface, its name stronger. A row under a heading stands in
         from it and is pressed to tick its box. Every row has a box first:
         it isolates (HealerRow.Ticked). A caster has their swatch. -->
    <DataTemplate x:Key="HealLine">
      <Button Style="{StaticResource CharacterPick}" Height="{StaticResource RowHeight}">
        <Grid>
          <Rectangle x:Name="Raised" Fill="{DynamicResource Bg2Brush}" Margin="0,0,0,1" Visibility="Collapsed"/>
          <Grid Style="{StaticResource PickCells}">
            <Rectangle Style="{StaticResource RowShade}" Margin="0,0,0,1" Fill="{Binding Shade}"
                       v:Grow.Share="{Binding Fraction}"/>
            <v:Cells Widths="{StaticResource Columns}" Margin="0,0,14,1">
              <DockPanel x:Name="NameCell" Margin="6,0,8,0" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource RowTick}" Margin="0,0,2,0" IsChecked="{Binding Ticked, Mode=TwoWay}"
                              ToolTip="{Binding TickName}" AutomationProperties.Name="{Binding TickName}"/>
                <Path x:Name="Caret" Style="{StaticResource RowCaret}" Margin="1,0,5,0"/>
                <Rectangle x:Name="Swatch" Style="{StaticResource Swatch}" Fill="{Binding Swatch}" Margin="0,0,6,0"/>
                <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock Text="{Binding Job}" Style="{StaticResource JobCell}" ToolTip="{Binding JobTip}"
                         Visibility="{Binding ShowJob, Converter={StaticResource Visible}}"/>
              <TextBlock Text="{Binding Healing}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
              <v:SmallBar For="Character" Length="48" Value="{Binding Fraction}" Fill="{Binding Swatch}">
                <TextBlock Text="{Binding Share}" Style="{StaticResource Fig}"/>
              </v:SmallBar>
              <TextBlock Text="{Binding Hps}" Style="{StaticResource Cell}"/>
              <TextBlock Text="{Binding Casts}" Style="{StaticResource Cell}"/>
              <TextBlock Text="{Binding Avg}" Style="{StaticResource FigQuiet}"/>
              <TextBlock Text="{Binding Mp}" Style="{StaticResource FigQuiet}"/>
              <TextBlock Text="{Binding PerMp}" Style="{StaticResource Fig}"/>
              <TextBlock Text="{Binding Overcure}" Style="{StaticResource FigQuiet}"/>
              <TextBlock Text="{Binding OvercurePct}" Style="{StaticResource Fig}"/>
              <TextBlock Text="{Binding PetHealing}" Style="{StaticResource Fig}"/>
            </v:Cells>
          </Grid>
          <Rectangle Style="{StaticResource RowRule}"/>
          <Rectangle Style="{StaticResource PickEdge}"/>
          <Path Style="{StaticResource OwnerMark}"
                Visibility="{Binding IsOwner, Converter={StaticResource Visible}}"/>
        </Grid>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsOwner}" Value="True">
          <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsTarget}" Value="True">
          <Setter TargetName="Swatch" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Nested}" Value="True">
          <Setter TargetName="NameCell" Property="Margin" Value="30,0,8,0"/>
          <Setter TargetName="Caret" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <!-- A target's heading. -->
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsTarget}" Value="True"/>
            <Condition Binding="{Binding Nested}" Value="False"/>
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Raised" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
        </MultiDataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <!-- The Overview, as the Damage section's: one table, and the bar is the
       row. By caster, each caster's row is shaded in their colour to their
       healing out of the leading caster's, and under it, while it is open,
       each target they healed; By target, the same table under each
       target's heading. Ticking a box isolates a caster, a target, or one
       caster at one target. A pane: the column headings stand still, the
       rows scroll under them, and the Party line stands still under the
       rows. Healing has no rates that can be low, so nothing is marked.

       Floating, it is a strip, as the damage card is: one short row per
       caster whichever tab is shown, the bar behind the name, and the
       figures a glance during a fight is for. -->
  <v:Pane Title="Overview"
          Hint="Total healed since the session started, by caster or by target. Select a row to show what is under it: a caster's targets, or a target's casters. Tick a box to isolate: a caster or a target, or one caster at one target. Hover a column heading for how it is counted, and press one to sort by it."
          PopOutCommand="{Binding Panels[hbars].PopOutCommand}"
          v:Shading.Characters="{Binding ShadeCharacters}">
    <!-- The note and the Clear link are of the two filters the boxes set,
         the casters' and the targets' (HealOverviewNote); floating, the card
         is the casters' strip, and they are the casters'. -->
    <v:Pane.Style>
      <Style TargetType="v:Pane" BasedOn="{StaticResource ZPane}">
        <Setter Property="Note" Value="{Binding HealOverviewNote}"/>
        <Style.Triggers>
          <Trigger Property="v:Float.On" Value="True">
            <Setter Property="Note" Value="{Binding HealerFilter.TableNote}"/>
          </Trigger>
        </Style.Triggers>
      </Style>
    </v:Pane.Style>
    <!-- Clear, while the boxes have something isolated; then the tabs, By
         caster and By target; then Columns. Neither in a panel: the strip
         has its own few columns, and no targets. -->
    <v:Pane.Tools>
      <StackPanel Orientation="Horizontal">
        <Button Content="Clear">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
              <Setter Property="Margin" Value="0,0,10,0"/>
              <Setter Property="Command" Value="{Binding ClearHealOverviewCommand}"/>
              <Setter Property="ToolTip" Value="Count every caster and every target again"/>
              <Setter Property="AutomationProperties.Name" Value="Clear the isolated casters and targets"/>
              <Setter Property="Visibility" Value="{Binding HealOverviewOn, Converter={StaticResource Visible}}"/>
              <Style.Triggers>
                <Trigger Property="v:Float.On" Value="True">
                  <Setter Property="Margin" Value="0,3,10,1"/>
                  <Setter Property="Command" Value="{Binding HealerFilter.ClearCommand}"/>
                  <Setter Property="ToolTip" Value="{Binding HealerFilter.ClearTip}"/>
                  <Setter Property="AutomationProperties.Name" Value="{Binding HealerFilter.TableClearName}"/>
                  <Setter Property="Visibility" Value="{Binding HealerFilter.IsOn, Converter={StaticResource Visible}}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Border Style="{StaticResource SegmentGroup}" Margin="0,0,8,0" VerticalAlignment="Center"
                Visibility="{Binding Path=(v:Float.On), RelativeSource={RelativeSource Self}, Converter={StaticResource Hidden}}">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource Segment}" GroupName="healOverviewBy" Content="By caster"
                         IsChecked="{Binding HealOverviewBy, Converter={StaticResource Equals}, ConverterParameter=Casters}"
                         ToolTip="Each caster's healing, and each target under them. Tick a box to isolate"
                         AutomationProperties.Name="Healing overview: by caster"/>
            <RadioButton Style="{StaticResource Segment}" GroupName="healOverviewBy" Content="By target"
                         IsChecked="{Binding HealOverviewBy, Converter={StaticResource Equals}, ConverterParameter=Targets}"
                         ToolTip="Each target's healing, and each caster under them. Tick a box to isolate"
                         AutomationProperties.Name="Healing overview: by target"/>
          </StackPanel>
        </Border>
        <v:ColumnsButton Table="{Binding HealersColumns}"/>
      </StackPanel>
    </v:Pane.Tools>
    <Grid>
      <!-- The strip, as the damage card's is (Views/BarsCard.xaml): the
           shade, the 3-unit edge, the owner's mark, the cells, and no
           effect on a row. -->
      <!-- Every column the table has (Tables.HealStrip), the panel's own
           choice of them and their order, and those at the end gone in a
           panel too narrow for them, as the damage strip's (Views/
           BarsCard.xaml says how). -->
      <StackPanel Style="{StaticResource StripRoom}" v:ColumnSet.Table="{Binding HealersColumns}"
                  Visibility="{Binding Path=(v:Float.On), RelativeSource={RelativeSource Self}, Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding HealEmptyText}" Style="{StaticResource Label}" FontSize="12" Margin="13,8,13,0"
                   Visibility="{Binding HasHealers, Converter={StaticResource Hidden}}"/>
        <v:Cells Style="{StaticResource Strip}" Height="{StaticResource HitRowHeight}" Margin="3,0" v:ColumnDrag.On="True"
                 Visibility="{Binding HasHealers, Converter={StaticResource Visible}}">
          <v:Caps Text="CHARACTER" Style="{StaticResource StripHead}" HorizontalAlignment="Left" Margin="10,0,4,0"/>
          <Border/>
          <Border Background="Transparent" ToolTip="Everything this character healed">
            <v:Caps Text="HEALING" Style="{StaticResource StripHead}"/>
          </Border>
          <Border Background="Transparent" ToolTip="This character's healing out of the whole party's">
            <v:Caps Text="%" Style="{StaticResource StripHead}"/>
          </Border>
          <Border Background="Transparent" ToolTip="Healing divided by the session clock">
            <v:Caps Text="HPS" Style="{StaticResource StripHead}"/>
          </Border>
          <Border Background="Transparent" ToolTip="One per cast, however many people it reached">
            <v:Caps Text="CASTS" Style="{StaticResource StripHead}"/>
          </Border>
          <Border Background="Transparent" ToolTip="Healing divided by casts" AutomationProperties.Name="Average per cast">
            <v:Caps Text="AVG" Style="{StaticResource StripHead}"/>
          </Border>
          <Border Background="Transparent" ToolTip="{StaticResource MpTip}">
            <v:Caps Text="MP SPENT" Style="{StaticResource StripHead}"/>
          </Border>
          <Border Background="Transparent" ToolTip="{StaticResource PerMpTip}">
            <v:Caps Text="HP/MP" Style="{StaticResource StripHead}"/>
          </Border>
          <Border Background="Transparent" ToolTip="{StaticResource OvercureTip}" AutomationProperties.Name="Overcure">
            <v:Caps Text="OVER" Style="{StaticResource StripHead}"/>
          </Border>
          <Border Background="Transparent" ToolTip="{StaticResource OvercurePctTip}" AutomationProperties.Name="Overcure %">
            <v:Caps Text="OVER %" Style="{StaticResource StripHead}"/>
          </Border>
          <Border Background="Transparent" ToolTip="Everything this character's pet healed. Part of Healing" AutomationProperties.Name="Pet healing">
            <v:Caps Text="PET" Style="{StaticResource StripHead}"/>
          </Border>
        </v:Cells>
        <ItemsControl ItemsSource="{Binding HealStrip}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid x:Name="Line" Height="{StaticResource HitRowHeight}" Margin="3,0,3,1" Background="Transparent"
                    ToolTip="{Binding Tip}">
                <Rectangle Style="{StaticResource RowShade}" Fill="{Binding Fill}" RadiusX="{StaticResource BarRadius}"
                           RadiusY="{StaticResource BarRadius}" v:Grow.Share="{Binding Fraction}"/>
                <Rectangle Width="3" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Edge}"
                           IsHitTestVisible="False"/>
                <!-- Whose file this is: found without reading the names. -->
                <Path Data="M0,0 L3.5,3.5 L0,7 Z" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left"
                      VerticalAlignment="Center" Margin="-3,0,0,0" IsHitTestVisible="False"
                      Visibility="{Binding IsOwner, Converter={StaticResource Visible}}"/>
                <v:Cells Style="{StaticResource Strip}">
                  <DockPanel LastChildFill="False" Margin="10,0,4,0">
                    <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Job}" Style="{StaticResource StripJob}"/>
                  </DockPanel>
                  <Border/>
                  <TextBlock Text="{Binding Healing}" Style="{StaticResource StripCell}" FontSize="12" FontWeight="SemiBold"/>
                  <v:SmallBar For="Character" Length="36" Inset="8" Value="{Binding Fraction}" Fill="{Binding Edge}">
                    <TextBlock Text="{Binding Share}" Style="{StaticResource StripCell}"/>
                  </v:SmallBar>
                  <TextBlock Text="{Binding Hps}" Style="{StaticResource StripCell}"/>
                  <TextBlock Text="{Binding Casts}" Style="{StaticResource StripCell}"/>
                  <TextBlock Text="{Binding Avg}" Style="{StaticResource StripCell}"/>
                  <TextBlock Text="{Binding Mp}" Style="{StaticResource StripCell}"/>
                  <TextBlock Text="{Binding PerMp}" Style="{StaticResource StripCell}"/>
                  <TextBlock Text="{Binding Overcure}" Style="{StaticResource StripCell}"/>
                  <TextBlock Text="{Binding OvercurePct}" Style="{StaticResource StripCell}"/>
                  <TextBlock Text="{Binding PetHealing}" Style="{StaticResource StripCell}"/>
                </v:Cells>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOwner}" Value="True">
                  <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Dimmed}" Value="True">
                  <Setter TargetName="Line" Property="Opacity" Value="0.5"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- The docked form: not in a floating panel. Its rows stand their
           cells where the player has dragged them, and leave out those
           hidden (v:ColumnSet). -->
      <Grid v:ColumnSet.Table="{Binding HealersColumns}"
            Visibility="{Binding Path=(v:Float.On), RelativeSource={RelativeSource Self}, Converter={StaticResource Hidden}}">
        <TextBlock Text="{Binding HealEmptyText}" Style="{StaticResource Label}" FontSize="12" Margin="0,18,0,8"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Visibility="{Binding HasHealers, Converter={StaticResource Hidden}}"/>

        <!-- Sideways, the table scrolls only in a pane too narrow for its
             columns. -->
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      v:WheelChain.On="True" Visibility="{Binding HasHealers, Converter={StaticResource Visible}}">
          <Grid MinWidth="1010" Width="{Binding ViewportWidth, ElementName=Scroller}">
            <Grid.Style>
              <Style TargetType="Grid">
                <Style.Triggers>
                  <!-- Room for the scroll bar a narrow pane brings: it is
                       drawn over the content, and would lie on the Party
                       line. -->
                  <DataTrigger Binding="{Binding ComputedHorizontalScrollBarVisibility, ElementName=Scroller}" Value="Visible">
                    <Setter Property="Margin" Value="0,0,0,12"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 14 units are kept clear at the right of the headings, the
                 rows' cells and the Party line: the room the rows' scroll
                 bar is drawn in. -->
            <Grid Height="{StaticResource ColumnHeadHeight}">
              <!-- Each heading orders the table (v:SortHead), and is
                   dragged to move its column (v:ColumnDrag). -->
              <v:Cells Widths="{StaticResource Columns}" Margin="0,0,14,1" v:SortHead.Sort="{Binding HealersSort}"
                       v:ColumnDrag.On="True">
                <v:SortHead Column="name" Words="True">
                  <TextBlock Padding="12,0,8,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource HeadText}">
                        <Setter Property="Text" Value="Caster"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HealOverviewByTarget}" Value="True">
                            <Setter Property="Text" Value="Target"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </v:SortHead>
                <v:SortHead Column="job" Words="True" Visibility="{Binding ShowJob, Converter={StaticResource Visible}}">
                  <TextBlock Text="Job" Style="{StaticResource HeadText}"/>
                </v:SortHead>
                <v:SortHead Column="healing">
                  <TextBlock Text="Healing" Style="{StaticResource Head}"
                             ToolTip="Every cure, waltz and healing ability this character used, and everything their pet healed"/>
                </v:SortHead>
                <v:SortHead Column="share">
                  <TextBlock Text="Healing %" Style="{StaticResource Head}"
                             ToolTip="This character's healing out of the whole party's"/>
                </v:SortHead>
                <v:SortHead Column="hps">
                  <TextBlock Text="HPS" Style="{StaticResource Head}" ToolTip="Healing divided by the session clock"/>
                </v:SortHead>
                <v:SortHead Column="casts">
                  <TextBlock Text="Casts" Style="{StaticResource Head}"
                             ToolTip="One per cast, however many people it reached"/>
                </v:SortHead>
                <v:SortHead Column="avg">
                  <TextBlock Text="Avg / cast" Style="{StaticResource Head}" ToolTip="Healing divided by casts"/>
                </v:SortHead>
                <v:SortHead Column="mp">
                  <TextBlock Text="MP Spent" Style="{StaticResource Head}" ToolTip="{StaticResource MpTip}"/>
                </v:SortHead>
                <v:SortHead Column="perMp">
                  <TextBlock Text="HP/MP" Style="{StaticResource Head}" ToolTip="{StaticResource PerMpTip}"/>
                </v:SortHead>
                <v:SortHead Column="overcure">
                  <TextBlock Text="Overcure" Style="{StaticResource Head}" ToolTip="{StaticResource OvercureTip}"/>
                </v:SortHead>
                <v:SortHead Column="overcurePct">
                  <TextBlock Text="Overcure %" Style="{StaticResource Head}" ToolTip="{StaticResource OvercurePctTip}"/>
                </v:SortHead>
                <v:SortHead Column="petHealing">
                  <TextBlock Text="Pet Healing" Style="{StaticResource Head}"
                             ToolTip="Everything this character's pet healed. Part of Healing"/>
                </v:SortHead>
              </v:Cells>
              <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>
            </Grid>

            <!-- The rows (HealLine). A heading is pressed to fold what is
                 under it, a row under one to tick its box; the boxes
                 isolate, and while anything is isolated the rows none of
                 which counts are dimmed, with their own figures. The
                 Healing % has a small bar beside it only while the row is
                 not shaded. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          v:WheelChain.On="True" Focusable="False">
              <Grid>
                <ItemsControl ItemsSource="{Binding Healers}" ItemTemplate="{StaticResource HealLine}" Focusable="False"
                              Visibility="{Binding HealOverviewByTarget, Converter={StaticResource Hidden}}"/>
                <ItemsControl ItemsSource="{Binding HealTargetRows}" ItemTemplate="{StaticResource HealLine}" Focusable="False"
                              Visibility="{Binding HealOverviewByTarget, Converter={StaticResource Visible}}"/>
              </Grid>
            </ScrollViewer>

            <!-- The Party line: the party as a whole under the columns it
                 sums, on the raised surface, unshaded. Its HPS is the
                 party's, rewritten with the rows'. -->
            <Grid Grid.Row="2" Height="{StaticResource PartyRowHeight}" Background="{DynamicResource Bg2Brush}">
              <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>
              <v:Cells Widths="{StaticResource Columns}" Margin="0,1,14,0">
                <TextBlock Text="Party" Style="{StaticResource CellText}" Padding="12,0,8,0" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding HealParty.Count}" Style="{StaticResource CellText}" FontSize="11"
                           Foreground="{DynamicResource Text3Brush}" Background="Transparent"
                           ToolTip="The characters listed above"
                           Visibility="{Binding ShowJob, Converter={StaticResource Visible}}"/>
                <TextBlock Text="{Binding HealParty.Healing}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding HealParty.Share}" Style="{StaticResource SubFigQuiet}"/>
                <TextBlock Text="{Binding HealParty.Hps}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding HealParty.Casts}" Style="{StaticResource Cell}"/>
                <TextBlock Text="{Binding HealParty.Avg}" Style="{StaticResource SubFigQuiet}"/>
                <TextBlock Text="{Binding HealParty.Mp}" Style="{StaticResource SubFigQuiet}"/>
                <TextBlock Text="{Binding HealParty.PerMp}" Style="{StaticResource SubFig}"/>
                <TextBlock Text="{Binding HealParty.Overcure}" Style="{StaticResource SubFigQuiet}"/>
                <TextBlock Text="{Binding HealParty.OvercurePct}" Style="{StaticResource SubFig}"/>
                <TextBlock Text="{Binding HealParty.PetHealing}" Style="{StaticResource SubFig}"/>
              </v:Cells>
            </Grid>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
  </v:Pane>
</UserControl>
