<UserControl x:Class="Zerg.Views.SupportCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:v="clr-namespace:Zerg.Views">
  <UserControl.Resources>
    <!-- What was cast, Casts, Hit, Miss, Hit %, and a blank column that
         ends the row. A narrower pane takes the room from the name first;
         when even the leasts do not fit, Miss and Hit % go (v:Shed, on the
         table below). -->
    <sys:String x:Key="Columns">300*150,64*52,56*44,56*44,72*56,8*0</sys:String>

    <!-- A figure, in the text ink; and the same in a column that goes. -->
    <Style x:Key="Figure" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Setter Property="Foreground" Value="{DynamicResource Text1Brush}"/>
    </Style>
    <Style x:Key="FigureSheds" TargetType="TextBlock" BasedOn="{StaticResource Figure}">
      <Style.Triggers>
        <Trigger Property="v:Shed.Narrow" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- Miss: a quieter ink while there are none, so the misses there are
         stand out. -->
    <Style x:Key="Miss" TargetType="TextBlock" BasedOn="{StaticResource FigureSheds}">
      <Style.Triggers>
        <Trigger Property="Text" Value="0">
          <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- The same three in the quieter ink, for a person an action reached. -->
    <Style x:Key="Quiet" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
    </Style>
    <Style x:Key="QuietSheds" TargetType="TextBlock" BasedOn="{StaticResource Quiet}">
      <Style.Triggers>
        <Trigger Property="v:Shed.Narrow" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="QuietMiss" TargetType="TextBlock" BasedOn="{StaticResource QuietSheds}">
      <Style.Triggers>
        <Trigger Property="Text" Value="0">
          <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- A character's heading: who, and their casts in all. On the
         heading surface, as the Heals table's are; not shaded, since there
         is no amount for a shade to be a share of. -->
    <DataTemplate x:Key="Heading">
      <Border Height="{StaticResource SubRowHeight}" Background="{DynamicResource Bg2Brush}">
        <v:Cells Widths="{StaticResource Columns}" Margin="0,0,14,1">
          <DockPanel Margin="12,0,8,0" VerticalAlignment="Center">
            <Rectangle Margin="0,0,6,0">
              <Rectangle.Style>
                <Style TargetType="Rectangle" BasedOn="{StaticResource Swatch}">
                  <Setter Property="Fill" Value="{Binding Swatch}"/>
                  <Style.Triggers>
                    <Trigger Property="v:Float.On" Value="True">
                      <Setter Property="Fill" Value="{Binding PanelSwatch}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Rectangle.Style>
            </Rectangle>
            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource Text1Brush}"/>
            <TextBlock Text="{Binding Job}" Style="{StaticResource Badge}" Foreground="{DynamicResource Text2Brush}"
                       TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <TextBlock Text="{Binding Casts}" Style="{StaticResource Figure}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Hits}" Style="{StaticResource Figure}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Misses}" Style="{StaticResource Miss}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding HitRate}" Style="{StaticResource FigureSheds}" FontWeight="SemiBold"/>
          <Border/>
        </v:Cells>
      </Border>
    </DataTemplate>

    <!-- One action under its caster: how often it was cast, and on how
         many of the people it reached it took effect. Pressing it lists
         those people under it, and it is then on the selected surface with
         its name in the heavier weight; pressing it again puts them away. -->
    <Style x:Key="ActionPick" TargetType="Button" BasedOn="{StaticResource RowPick}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Open}" Value="True">
          <Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="Action">
      <Button Style="{StaticResource ActionPick}"
              Command="{Binding DataContext.ToggleSupportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}"
              ToolTip="Show or hide the people it reached">
        <v:Cells Widths="{StaticResource Columns}" Margin="0,0,14,1">
          <DockPanel Margin="14,0,8,0" VerticalAlignment="Center">
            <Path Style="{StaticResource RowCaret}" Margin="0,0,6,0"/>
            <TextBlock x:Name="Name" Text="{Binding Name}" Style="{StaticResource CellText}" Padding="0"
                       Foreground="{DynamicResource Text1Brush}"/>
          </DockPanel>
          <TextBlock Text="{Binding Casts}" Style="{StaticResource Figure}"/>
          <TextBlock Text="{Binding Hits}" Style="{StaticResource Figure}"/>
          <TextBlock Text="{Binding Misses}" Style="{StaticResource Miss}"/>
          <TextBlock Text="{Binding HitRate}" Style="{StaticResource FigureSheds}"/>
          <Border/>
        </v:Cells>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Open}" Value="True">
          <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One person an opened action reached, in their colour: how many of
         its casts reached them, and on how many it took effect. In the
         quieter ink, a step under the action. -->
    <DataTemplate x:Key="Under">
      <Border Height="{StaticResource SubRowHeight}">
        <v:Cells Widths="{StaticResource Columns}" Margin="0,0,14,1">
          <DockPanel Margin="46,0,8,0" VerticalAlignment="Center">
            <Rectangle Width="6" Height="6" Margin="0,0,6,0">
              <Rectangle.Style>
                <Style TargetType="Rectangle" BasedOn="{StaticResource Swatch}">
                  <Setter Property="Fill" Value="{Binding Swatch}"/>
                  <Style.Triggers>
                    <Trigger Property="v:Float.On" Value="True">
                      <Setter Property="Fill" Value="{Binding PanelSwatch}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Rectangle.Style>
            </Rectangle>
            <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" Padding="0"
                       Foreground="{DynamicResource Text2Brush}"/>
          </DockPanel>
          <TextBlock Text="{Binding Casts}" Style="{StaticResource Quiet}"/>
          <TextBlock Text="{Binding Hits}" Style="{StaticResource Quiet}"/>
          <TextBlock Text="{Binding Misses}" Style="{StaticResource QuietMiss}"/>
          <TextBlock Text="{Binding HitRate}" Style="{StaticResource QuietSheds}"/>
          <Border/>
        </v:Cells>
      </Border>
    </DataTemplate>

    <v:ActionRowTemplates x:Key="Templates" Heading="{StaticResource Heading}" Action="{StaticResource Action}"
                          Under="{StaticResource Under}"/>
  </UserControl.Resources>

  <!-- Every buff, status removal and ward, under the character who cast
       it, with how often, and on how many of the people it reached it
       took effect: what one of the party did to one of the party that was
       not a heal. There is no amount, so there is nothing else to say of
       one. An action is pressed (or Enter or Space, with the keyboard on
       it) to list the people it reached under it. The column headings stand still and the rows scroll under them, in
       whatever height the pane or the panel has. The table says whether
       there is room for every column (v:Shed.Full). -->
  <v:Pane Title="Support" Note="{Binding SupportNote}"
          Hint="Buffs, status removals and wards: casts by character and action, and on how many they took. Select an action to show who it reached. Never damage or healing"
          PopOutCommand="{Binding Panels[hsupport].PopOutCommand}">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="{Binding SupportEmptyText}" Style="{StaticResource Label}" FontSize="12"
                 Margin="0,18,0,8" HorizontalAlignment="Center"
                 Visibility="{Binding HasSupport, Converter={StaticResource Hidden}}"/>

      <Grid Visibility="{Binding HasSupport, Converter={StaticResource Visible}}" v:Shed.Full="{StaticResource Columns}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Height="{StaticResource ColumnHeadHeight}">
          <v:Cells Widths="{StaticResource Columns}" Margin="0,0,14,1">
            <TextBlock Text="Character / action" Style="{StaticResource HeadText}" Padding="12,0,8,0"/>
            <TextBlock Text="Casts" Style="{StaticResource Head}" ToolTip="One per cast, however many people it reached"/>
            <TextBlock Text="Hit" Style="{StaticResource Head}" ToolTip="The people it took effect on"/>
            <TextBlock Text="Miss" Style="{StaticResource HeadSheds}"
                       ToolTip="The people it had no effect on: an Erase that found nothing to remove, a Protect on someone with a stronger one"/>
            <TextBlock Text="Hit %" Style="{StaticResource HeadSheds}" ToolTip="Hit out of everyone it reached"/>
            <Border/>
          </v:Cells>
          <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>
        </Grid>
        <Grid Grid.Row="1">
          <Grid.Style>
            <Style TargetType="Grid">
              <Style.Triggers>
                <Trigger Property="v:SplitPanel.Stacked" Value="True">
                  <Setter Property="MaxHeight" Value="340"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        v:WheelChain.On="True" Focusable="False">
            <ItemsControl ItemsSource="{Binding SupportRows}" ItemTemplateSelector="{StaticResource Templates}"
                          Focusable="False"/>
          </ScrollViewer>
        </Grid>
      </Grid>
    </DockPanel>
  </v:Pane>
</UserControl>
