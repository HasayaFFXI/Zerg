<UserControl x:Class="Zerg.Views.ColumnsButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Zerg.Views"
             Focusable="False" VerticalAlignment="Center"
             Visibility="{Binding Path=(v:Float.On), RelativeSource={RelativeSource Self}, Converter={StaticResource Hidden}}">
  <!-- A table's Columns menu, under its button in the pane's heading: a
       line for every column but the first, in the order they stand, and a
       group's columns under its own line, which shows or hides them all.
       Not in a floating panel. -->
  <Button x:Name="Press" Click="OnPress" Style="{StaticResource GhostButton}" Height="22"
          Padding="10,0,8,0" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"
          ContextMenuService.IsEnabled="False" AutomationProperties.Name="Columns"
          ToolTip="Choose which columns the table shows. Drag a column's heading to move it">
    <Button.Resources>
      <ContextMenu x:Key="Menu"/>
    </Button.Resources>
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="Columns" VerticalAlignment="Center"/>
      <Path Data="M0,0 L3.5,3.5 L7,0" Width="7" Height="4" StrokeThickness="1.2" Margin="6,1,0,0"
            VerticalAlignment="Center"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </StackPanel>
  </Button>
</UserControl>
