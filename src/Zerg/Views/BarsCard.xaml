<UserControl x:Class="Zerg.Views.BarsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:v="clr-namespace:Zerg.Views"
             xmlns:layout="clr-namespace:Zerg.Core.Layout;assembly=Zerg.Core">
  <UserControl.Resources>
    <!-- Character, Job, then seventeen figures, and when the table drops
         them in a narrow pane: Zerg.Core/Layout/CharacterColumns. The cells
         are written in that order; where the player has dragged columns
         or hidden them from the Columns menu, each row stands them as the
         table says (v:ColumnSet, on the docked form below), and a hidden
         column needs no room. Worked out with the Job column there: with
         names hidden it goes a little early. -->
    <Style x:Key="Table" TargetType="v:Cells">
      <Setter Property="Widths" Value="{x:Static layout:CharacterColumns.Shaded}"/>
      <Style.Triggers>
        <Trigger Property="v:Shading.Characters" Value="False">
          <Setter Property="Widths" Value="{x:Static layout:CharacterColumns.Unshaded}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- The docked form says whether its columns fit (v:Shed.Full, and
         v:Shed.Less for the second step); the columns hidden need no room. -->
    <Style x:Key="TableRoom" TargetType="Grid">
      <Setter Property="v:Shed.Full" Value="{x:Static layout:CharacterColumns.Shaded}"/>
      <Setter Property="v:Shed.Less" Value="{x:Static layout:CharacterColumns.LessShaded}"/>
      <Style.Triggers>
        <Trigger Property="v:Shading.Characters" Value="False">
          <Setter Property="v:Shed.Full" Value="{x:Static layout:CharacterColumns.Unshaded}"/>
          <Setter Property="v:Shed.Less" Value="{x:Static layout:CharacterColumns.LessUnshaded}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- A group's name between two hairlines, over its columns. -->
    <ControlTemplate x:Key="Group" TargetType="ContentControl">
      <Grid>
        <!-- The rule that begins the group, beside its column headings. -->
        <Rectangle Width="1" HorizontalAlignment="Left" Margin="1,20,0,0" Fill="{DynamicResource LineBrush}"
                   SnapsToDevicePixels="True"/>
        <Grid VerticalAlignment="Top" Margin="8,5,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>
          <ContentPresenter Grid.Column="1" Margin="8,0" VerticalAlignment="Center"/>
          <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center" Fill="{DynamicResource Line2Brush}"
                     SnapsToDevicePixels="True"/>
        </Grid>
      </Grid>
    </ControlTemplate>
    <!-- A group goes with its columns: Weaponskill second, the other two
         first. -->
    <Style x:Key="GroupShedsLate" TargetType="ContentControl">
      <Setter Property="Template" Value="{StaticResource Group}"/>
      <Setter Property="Focusable" Value="False"/>
      <Style.Triggers>
        <Trigger Property="v:Shed.Tight" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="GroupSheds" TargetType="ContentControl">
      <Setter Property="Template" Value="{StaticResource Group}"/>
      <Setter Property="Focusable" Value="False"/>
      <Style.Triggers>
        <Trigger Property="v:Shed.Narrow" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- The same rule carried through the Party line. -->
    <Style x:Key="PartyRule" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Line2Brush}"/>
      <Setter Property="BorderThickness" Value="1,0,0,0"/>
      <Setter Property="Margin" Value="1,0,0,0"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="PartyRuleShedsLate" TargetType="Border" BasedOn="{StaticResource PartyRule}">
      <Style.Triggers>
        <Trigger Property="v:Shed.Tight" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PartyRuleSheds" TargetType="Border" BasedOn="{StaticResource PartyRule}">
      <Style.Triggers>
        <Trigger Property="v:Shed.Narrow" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- A character's deaths: in Crit, where there is one; none is a dash,
         which the figure's own trigger inks quietly. -->
    <Style x:Key="DeathsFig" TargetType="TextBlock" BasedOn="{StaticResource FigSheds}">
      <Setter Property="Foreground" Value="{DynamicResource CritBrush}"/>
    </Style>
    <Style x:Key="PartyDeathsFig" TargetType="TextBlock" BasedOn="{StaticResource SubFigSheds}">
      <Setter Property="Foreground" Value="{DynamicResource CritBrush}"/>
    </Style>

    <!-- The strip: Character, then Damage, %, Acc%, Crit%, Delay and the ranged
         two (R.Acc%, R.Crit%), each wide enough for its longest figure or
         its heading so one growing a digit moves nothing beside it; a figure
         ends 2 units short of its column. The name has what is left, and
         110 at least: in a panel too narrow for that the strip drops Deaths,
         the four rates and the job beside the name (v:Shed, as the Actions
         table drops columns), which is the strip the design draws 250 wide.
         With "shade characters" off the share is a small bar beside the %
         figure, which needs the room. -->
    <sys:String x:Key="StripColumns">1*110,72,52,56,56,58,62,66,40</sys:String>
    <sys:String x:Key="StripBarColumns">1*110,72,96,56,56,58,62,66,40</sys:String>
    <Style x:Key="Strip" TargetType="v:Cells">
      <Setter Property="Widths" Value="{StaticResource StripColumns}"/>
      <Style.Triggers>
        <Trigger Property="v:Shading.Characters" Value="False">
          <Setter Property="Widths" Value="{StaticResource StripBarColumns}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- The strip itself says whether its columns fit (v:Shed.Full). -->
    <Style x:Key="StripRoom" TargetType="StackPanel">
      <Setter Property="v:Shed.Full" Value="{StaticResource StripColumns}"/>
      <Style.Triggers>
        <Trigger Property="v:Shading.Characters" Value="False">
          <Setter Property="v:Shed.Full" Value="{StaticResource StripBarColumns}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- A column's heading in the strip: small capitals, set against the
         column's right-hand end as its figures are. -->
    <Style x:Key="StripHead" TargetType="v:Caps" BasedOn="{StaticResource GroupCaps}">
      <Setter Property="Tracking" Value="0.6"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Margin" Value="4,0,2,0"/>
    </Style>
    <Style x:Key="StripCell" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Padding" Value="4,0,2,0"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
      <Style.Triggers>
        <!-- Nothing to measure: a dash, in the quietest ink. -->
        <Trigger Property="Text" Value="&#x2014;">
          <Setter Property="Foreground" Value="{DynamicResource Text4Brush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- The last column's, which goes in a narrow panel. -->
    <Style x:Key="StripCellSheds" TargetType="TextBlock" BasedOn="{StaticResource StripCell}">
      <Style.Triggers>
        <Trigger Property="v:Shed.Narrow" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StripDeaths" TargetType="TextBlock" BasedOn="{StaticResource StripCellSheds}">
      <Setter Property="Foreground" Value="{DynamicResource CritBrush}"/>
    </Style>
    <!-- The job beside the name: quieter than the name, and gone in a
         narrow panel (and where there is none to show, as any badge). -->
    <Style x:Key="StripJob" TargetType="TextBlock" BasedOn="{StaticResource Badge}">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
      <Style.Triggers>
        <Trigger Property="v:Shed.Narrow" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- A row of the docked table, in either tab: a heading (a character,
         or in By target a target), or a row under one (Nested: a target
         under a character, a character under a target). A heading is
         pressed to fold what is under it, and wears a caret that says
         which way it is; a target's heading is on the raised surface, its
         name stronger, with how many of it were killed after its name. A
         row under a heading stands in from it, and is pressed to tick its
         box. Every row has a box first: it isolates (ActorRow.Ticked).
         A row names a target (IsTarget) or a character, who has their
         swatch. -->
    <DataTemplate x:Key="ActorLine">
      <Button Style="{StaticResource CharacterPick}" Height="{StaticResource RowHeight}">
        <Grid>
          <Rectangle x:Name="Raised" Fill="{DynamicResource Bg2Brush}" Margin="0,0,0,1" Visibility="Collapsed"/>
          <Grid Style="{StaticResource PickCells}">
            <Rectangle Style="{StaticResource RowShade}" Margin="0,0,0,1" Fill="{Binding Shade}"
                       v:Grow.Share="{Binding Fraction}"/>
            <v:Cells Style="{StaticResource Table}" Margin="0,0,14,1">
              <DockPanel x:Name="NameCell" Margin="6,0,8,0" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource RowTick}" Margin="0,0,2,0" IsChecked="{Binding Ticked, Mode=TwoWay}"
                              ToolTip="{Binding TickName}" AutomationProperties.Name="{Binding TickName}"/>
                <Path x:Name="Caret" Style="{StaticResource RowCaret}" Margin="1,0,5,0"/>
                <Rectangle x:Name="Swatch" Style="{StaticResource Swatch}" Fill="{Binding Swatch}" Margin="0,0,6,0"/>
                <TextBlock x:Name="Name" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                  <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding Tag, Mode=OneWay}" FontWeight="Normal"
                       Foreground="{DynamicResource Text3Brush}"/>
                </TextBlock>
              </DockPanel>
              <TextBlock Text="{Binding Job}" Style="{StaticResource JobCell}" ToolTip="{Binding JobTip}"
                         Visibility="{Binding ShowJob, Converter={StaticResource Visible}}"/>
              <TextBlock Text="{Binding Damage}" Style="{StaticResource Cell}" FontWeight="SemiBold" Padding="2,0,8,0"/>
              <v:SmallBar For="Character" Length="48" Value="{Binding Fraction}" Fill="{Binding Swatch}">
                <TextBlock Text="{Binding Share}" Style="{StaticResource Cell}"/>
              </v:SmallBar>
              <TextBlock Text="{Binding Dps}" Style="{StaticResource Cell}" Padding="2,0,8,0"/>
              <v:LowMark Rate="{Binding AccuracyRate}" Style="{StaticResource ShedsLate}">
                <TextBlock Text="{Binding Accuracy}" Style="{StaticResource Fig}"/>
              </v:LowMark>
              <TextBlock Text="{Binding Crit}" Style="{StaticResource FigShedsLate}"/>
              <TextBlock Text="{Binding Delay}" Style="{StaticResource FigShedsLate}"/>
              <v:LowMark Rate="{Binding RangedAccuracyRate}" Style="{StaticResource Sheds}">
                <TextBlock Text="{Binding RangedAccuracy}" Style="{StaticResource Fig}"/>
              </v:LowMark>
              <TextBlock Text="{Binding RangedCrit}" Style="{StaticResource FigSheds}"/>
              <TextBlock Text="{Binding WsDamage}" Style="{StaticResource FigShedsLate}" Padding="2,0,8,0"/>
              <TextBlock Text="{Binding WsAvg}" Style="{StaticResource FigQuietShedsLate}"/>
              <TextBlock Text="{Binding WsShare}" Style="{StaticResource FigQuietShedsLate}"/>
              <v:LowMark Rate="{Binding WsAccuracyRate}" Style="{StaticResource ShedsLate}">
                <TextBlock Text="{Binding WsAccuracy}" Style="{StaticResource Fig}"/>
              </v:LowMark>
              <TextBlock Text="{Binding ScDamage}" Style="{StaticResource FigSheds}" Padding="2,0,8,0"/>
              <TextBlock Text="{Binding ScShare}" Style="{StaticResource FigQuietSheds}"/>
              <TextBlock Text="{Binding PetDamage}" Style="{StaticResource FigSheds}" Padding="2,0,8,0"/>
              <v:LowMark Rate="{Binding PetAccuracyRate}" Style="{StaticResource Sheds}">
                <TextBlock Text="{Binding PetAccuracy}" Style="{StaticResource Fig}"/>
              </v:LowMark>
              <TextBlock Text="{Binding Deaths}" Style="{StaticResource DeathsFig}"/>
            </v:Cells>
          </Grid>
          <Rectangle Style="{StaticResource RowRule}"/>
          <Rectangle Style="{StaticResource PickEdge}"/>
          <Path Style="{StaticResource OwnerMark}"
                Visibility="{Binding IsOwner, Converter={StaticResource Visible}}"/>
        </Grid>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsOwner}" Value="True">
          <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Isolated}" Value="True">
          <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsTarget}" Value="True">
          <Setter TargetName="Swatch" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Nested}" Value="True">
          <Setter TargetName="NameCell" Property="Margin" Value="30,0,8,0"/>
          <Setter TargetName="Caret" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <!-- A target's heading. -->
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsTarget}" Value="True"/>
            <Condition Binding="{Binding Nested}" Value="False"/>
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Raised" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
        </MultiDataTrigger>
        <!-- A target has no job, and its name is often longer than a
             character's: it runs on over the Job column, where there is one
             straight after the name. -->
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsTarget}" Value="True"/>
            <Condition Binding="{Binding ShowJob}" Value="True"/>
            <Condition Binding="{Binding Path=(v:ColumnSet.Layout).AfterLead, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                       Value="job"/>
            <Condition Binding="{Binding Nested}" Value="False"/>
          </MultiDataTrigger.Conditions>
          <Setter TargetName="NameCell" Property="Margin" Value="6,0,-54,0"/>
        </MultiDataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsTarget}" Value="True"/>
            <Condition Binding="{Binding ShowJob}" Value="True"/>
            <Condition Binding="{Binding Path=(v:ColumnSet.Layout).AfterLead, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                       Value="job"/>
            <Condition Binding="{Binding Nested}" Value="True"/>
          </MultiDataTrigger.Conditions>
          <Setter TargetName="NameCell" Property="Margin" Value="30,0,-54,0"/>
        </MultiDataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <!-- The Overview, By character: one table, and the bar is the row. Each
       character's row is shaded in their colour from its left edge to a
       length that is their damage out of the leader's, with all seventeen
       figures on top. A pane: the column headings stand still, the rows
       scroll under them, and the Party line stands still under the rows.
       By target is the same table under each target's heading: the
       headings and the rows are one list (TargetRows), drawn with the same
       row (ActorLine), and the tab not shown is collapsed.

       Floating, it is a strip instead: one short row per character, the bar
       behind the name, and three figures. For an alliance the whole table
       would cover the game it is laid over.

       The pane says how its rows are drawn (v:Shading), to both forms. -->
  <v:Pane Title="Overview"
          Hint="Total dealt since the session started, by character or by target. Select a row to show what is under it: a character's targets, or a target's characters. Tick a box to isolate: a character or a target, or one character at one target. Hover a column heading for how it is counted, and press one to sort by it."
          PopOutCommand="{Binding Panels[bars].PopOutCommand}"
          v:Shading.Characters="{Binding ShadeCharacters}" v:Shading.LowAccuracy="{Binding LowAccuracy}">
    <!-- The note and the Clear link are of the two filters the boxes set,
         the characters' and the targets' (OverviewNote); floating, the card
         is the characters' strip whichever tab is shown, and they are the
         characters'. -->
    <v:Pane.Style>
      <Style TargetType="v:Pane" BasedOn="{StaticResource ZPane}">
        <Setter Property="Note" Value="{Binding OverviewNote}"/>
        <Style.Triggers>
          <Trigger Property="v:Float.On" Value="True">
            <Setter Property="Note" Value="{Binding CharacterFilter.TableNote}"/>
          </Trigger>
        </Style.Triggers>
      </Style>
    </v:Pane.Style>
    <!-- Clear, while the tab's filter has something isolated: the
         command bar's buttons have marks of other names, and both can be on
         screen. Then the tabs, By character and By target, as the Filters
         pane's are; then Columns, a menu of every column the table can
         show, its groups' columns under their names (v:ColumnsButton).
         Neither in a panel: the strip has
         none of the groups, and no targets. -->
    <v:Pane.Tools>
      <StackPanel Orientation="Horizontal">
        <Button Content="Clear">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
              <Setter Property="Margin" Value="0,0,10,0"/>
              <Setter Property="Command" Value="{Binding ClearOverviewCommand}"/>
              <Setter Property="ToolTip" Value="Count every character and every target again"/>
              <Setter Property="AutomationProperties.Name" Value="Clear the isolated characters and targets"/>
              <Setter Property="Visibility" Value="{Binding OverviewOn, Converter={StaticResource Visible}}"/>
              <Style.Triggers>
                <Trigger Property="v:Float.On" Value="True">
                  <Setter Property="Margin" Value="0,3,10,1"/>
                  <Setter Property="Command" Value="{Binding CharacterFilter.ClearCommand}"/>
                  <Setter Property="ToolTip" Value="{Binding CharacterFilter.ClearTip}"/>
                  <Setter Property="AutomationProperties.Name" Value="{Binding CharacterFilter.TableClearName}"/>
                  <Setter Property="Visibility" Value="{Binding CharacterFilter.IsOn, Converter={StaticResource Visible}}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Border Style="{StaticResource SegmentGroup}" Margin="0,0,8,0" VerticalAlignment="Center"
                Visibility="{Binding Path=(v:Float.On), RelativeSource={RelativeSource Self}, Converter={StaticResource Hidden}}">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource Segment}" GroupName="overviewBy" Content="By character"
                         IsChecked="{Binding OverviewBy, Converter={StaticResource Equals}, ConverterParameter=Characters}"
                         ToolTip="Each character's damage, and each target under them. Tick a box to isolate"
                         AutomationProperties.Name="Overview: by character"/>
            <RadioButton Style="{StaticResource Segment}" GroupName="overviewBy" Content="By target"
                         IsChecked="{Binding OverviewBy, Converter={StaticResource Equals}, ConverterParameter=Targets}"
                         ToolTip="Each target's damage, and each character under it. Tick a box to isolate"
                         AutomationProperties.Name="Overview: by target"/>
          </StackPanel>
        </Border>
        <v:ColumnsButton Table="{Binding BarsColumns}"/>
      </StackPanel>
    </v:Pane.Tools>
    <Grid>
      <!-- The strip. A line of headings, then a row per character, 20
           units and a gap of 1. Back to front in a row: the shade, in the
           character's colour at the strength a panel allows it, from the
           row's left edge to their damage out of the leader's (gone while
           "shade characters" is off, when a small bar stands beside the %
           figure instead); a solid edge 3 units wide in the same colour,
           which stands in for a swatch and stays either way; the owner's
           mark, in the gutter left of the row; the cells.

           Nothing in a row has an effect of its own: the halo round a
           panel's text is one effect on the whole card (PanelWindow), and
           a row is the hot path. Nothing here moves with the clock. A row
           is not pressed here: a panel lies over the game, and is often
           clicked through. One not among the characters isolated is
           quieter, as in the table. -->
      <StackPanel Style="{StaticResource StripRoom}"
                  Visibility="{Binding Path=(v:Float.On), RelativeSource={RelativeSource Self}, Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Label}" FontSize="12" Margin="13,8,13,0"
                   Visibility="{Binding HasActors, Converter={StaticResource Hidden}}"/>
        <v:Cells Style="{StaticResource Strip}" Height="{StaticResource HitRowHeight}" Margin="3,0"
                 Visibility="{Binding HasActors, Converter={StaticResource Visible}}">
          <v:Caps Text="CHARACTER" Style="{StaticResource StripHead}" HorizontalAlignment="Left" Margin="10,0,4,0"/>
          <v:Caps Text="DAMAGE" Style="{StaticResource StripHead}"/>
          <!-- A border, so the whole of the column's heading shows the tooltip. -->
          <Border Background="Transparent" ToolTip="This character's damage out of the whole party's">
            <v:Caps Text="%" Style="{StaticResource StripHead}"/>
          </Border>
          <Border Background="Transparent" Style="{StaticResource Sheds}"
                  ToolTip="Auto-attacks that connected, out of all attempted">
            <v:Caps Text="ACC%" Style="{StaticResource StripHead}"/>
          </Border>
          <Border Background="Transparent" Style="{StaticResource Sheds}"
                  ToolTip="Auto-attacks that landed a critical hit, out of those that dealt damage">
            <v:Caps Text="CRIT%" Style="{StaticResource StripHead}"/>
          </Border>
          <Border Background="Transparent" Style="{StaticResource Sheds}"
                  ToolTip="The average time from one round of auto-attacks to the next, in seconds">
            <v:Caps Text="DELAY" Style="{StaticResource StripHead}"/>
          </Border>
          <Border Background="Transparent" Style="{StaticResource Sheds}"
                  ToolTip="Ranged attacks that connected, out of all attempted">
            <v:Caps Text="R.ACC%" Style="{StaticResource StripHead}"/>
          </Border>
          <Border Background="Transparent" Style="{StaticResource Sheds}"
                  ToolTip="Ranged attacks that landed a critical hit, out of those that dealt damage">
            <v:Caps Text="R.CRIT%" Style="{StaticResource StripHead}"/>
          </Border>
          <Border Background="Transparent" Style="{StaticResource Sheds}"
                  ToolTip="How many times this character died in the session">
            <v:Caps Text="DTH" Style="{StaticResource StripHead}"/>
          </Border>
        </v:Cells>
        <ItemsControl ItemsSource="{Binding Strip}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid x:Name="Line" Height="{StaticResource HitRowHeight}" Margin="3,0,3,1" Background="Transparent"
                    ToolTip="{Binding Tip}">
                <Rectangle Style="{StaticResource RowShade}" Fill="{Binding Fill}" RadiusX="{StaticResource BarRadius}"
                           RadiusY="{StaticResource BarRadius}" v:Grow.Share="{Binding Fraction}"/>
                <Rectangle Width="3" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Edge}"
                           IsHitTestVisible="False"/>
                <!-- Whose file this is: found without reading the names. -->
                <Path Data="M0,0 L3.5,3.5 L0,7 Z" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left"
                      VerticalAlignment="Center" Margin="-3,0,0,0" IsHitTestVisible="False"
                      Visibility="{Binding IsOwner, Converter={StaticResource Visible}}"/>
                <v:Cells Style="{StaticResource Strip}">
                  <DockPanel LastChildFill="False" Margin="10,0,4,0">
                    <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Job}" Style="{StaticResource StripJob}"/>
                  </DockPanel>
                  <TextBlock Text="{Binding Damage}" Style="{StaticResource StripCell}" FontSize="12" FontWeight="SemiBold"/>
                  <v:SmallBar For="Character" Length="36" Inset="8" Value="{Binding Fraction}" Fill="{Binding Edge}">
                    <TextBlock Text="{Binding Share}" Style="{StaticResource StripCell}"/>
                  </v:SmallBar>
                  <TextBlock Text="{Binding Accuracy}" Style="{StaticResource StripCellSheds}"/>
                  <TextBlock Text="{Binding Crit}" Style="{StaticResource StripCellSheds}"/>
                  <TextBlock Text="{Binding Delay}" Style="{StaticResource StripCellSheds}"/>
                  <TextBlock Text="{Binding RangedAccuracy}" Style="{StaticResource StripCellSheds}"/>
                  <TextBlock Text="{Binding RangedCrit}" Style="{StaticResource StripCellSheds}"/>
                  <TextBlock Text="{Binding Deaths}" Style="{StaticResource StripDeaths}"/>
                </v:Cells>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOwner}" Value="True">
                  <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Dimmed}" Value="True">
                  <Setter TargetName="Line" Property="Opacity" Value="0.5"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- The docked form: not in a floating panel. -->
      <Grid Style="{StaticResource TableRoom}" v:ColumnSet.Table="{Binding BarsColumns}"
            Visibility="{Binding Path=(v:Float.On), RelativeSource={RelativeSource Self}, Converter={StaticResource Hidden}}">
        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Label}" FontSize="12" Margin="0,18,0,8"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Visibility="{Binding HasActors, Converter={StaticResource Hidden}}"/>

        <!-- Sideways, the table scrolls only in a pane too narrow for the
             five columns it keeps last: their leasts and the 14 units kept
             clear at the right. -->
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      v:WheelChain.On="True" Visibility="{Binding HasActors, Converter={StaticResource Visible}}">
          <Grid Width="{Binding ViewportWidth, ElementName=Scroller}">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="MinWidth" Value="350"/>
                <Style.Triggers>
                  <Trigger Property="v:Shading.Characters" Value="False">
                    <Setter Property="MinWidth" Value="388"/>
                  </Trigger>
                  <!-- Room for the scroll bar a narrow pane brings: it is
                       drawn over the content, and would lie on the Party
                       line. -->
                  <DataTrigger Binding="{Binding ComputedHorizontalScrollBarVisibility, ElementName=Scroller}" Value="Visible">
                    <Setter Property="Margin" Value="0,0,0,12"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- The headings: the groups' names over their columns, then
                 one word per column. 14 units are kept clear at the right
                 of the headings, the rows' cells and the Party line: the
                 room the rows' scroll bar is drawn in. -->
            <Grid Height="{StaticResource GroupedHeadHeight}">
              <!-- In the table's own columns, so each group stands over
                   its two or four at any width and wherever it has been
                   moved: nothing over the first eight (each a cell of its
                   own, to go and move as theirs do), then the four groups.
                   A group's name is dragged to move the group
                   (v:ColumnDrag), as its headings are. -->
              <v:Cells Style="{StaticResource Table}" Margin="0,0,14,1" v:ColumnDrag.On="True">
                <Border/>
                <Border Visibility="{Binding ShowJob, Converter={StaticResource Visible}}"/>
                <Border/>
                <Border/>
                <Border/>
                <Border Style="{StaticResource ShedsLate}"/>
                <Border Style="{StaticResource ShedsLate}"/>
                <Border Style="{StaticResource ShedsLate}"/>
                <ContentControl v:Cells.Span="2" Style="{StaticResource GroupSheds}">
                  <v:Caps Text="Ranged" Style="{StaticResource GroupCaps}"/>
                </ContentControl>
                <ContentControl v:Cells.Span="4" Style="{StaticResource GroupShedsLate}">
                  <v:Caps Text="Weaponskill" Style="{StaticResource GroupCaps}"/>
                </ContentControl>
                <ContentControl v:Cells.Span="2" Style="{StaticResource GroupSheds}">
                  <v:Caps Text="Skillchain" Style="{StaticResource GroupCaps}"/>
                </ContentControl>
                <ContentControl v:Cells.Span="2" Style="{StaticResource GroupSheds}">
                  <v:Caps Text="Pet" Style="{StaticResource GroupCaps}"/>
                </ContentControl>
                <Border Style="{StaticResource Sheds}"/>
              </v:Cells>
              <!-- Each heading orders the table (v:SortHead), and is
                   dragged to move its column (v:ColumnDrag); a column that
                   goes in a narrow pane takes its heading with it. Where two
                   say the same, a script and a reader tell them apart by
                   the group's name. -->
              <v:Cells Style="{StaticResource Table}" Margin="0,16,14,1" v:SortHead.Sort="{Binding BarsSort}"
                       v:ColumnDrag.On="True">
                <v:SortHead Column="name" Words="True">
                  <TextBlock Padding="12,0,8,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource HeadText}">
                        <Setter Property="Text" Value="Character"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding OverviewByTarget}" Value="True">
                            <Setter Property="Text" Value="Target"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </v:SortHead>
                <v:SortHead Column="job" Words="True" Visibility="{Binding ShowJob, Converter={StaticResource Visible}}">
                  <TextBlock Text="Job" Style="{StaticResource HeadText}"/>
                </v:SortHead>
                <v:SortHead Column="damage">
                  <TextBlock Text="Damage" Style="{StaticResource Head}" Padding="0,0,8,0"
                             ToolTip="Everything this character dealt: attacks, weaponskills, job abilities, magic, additional effects, counters and spikes, their pet, and the skillchains they closed while Include Skillchains is on"/>
                </v:SortHead>
                <v:SortHead Column="share">
                  <TextBlock Text="Damage %" Style="{StaticResource Head}" Padding="0,0,8,0"
                             ToolTip="This character's damage out of the whole party's"/>
                </v:SortHead>
                <v:SortHead Column="dps">
                  <TextBlock Text="DPS" Style="{StaticResource Head}" Padding="0,0,8,0" ToolTip="Damage divided by the session clock"/>
                </v:SortHead>
                <v:SortHead Column="accuracy" Style="{StaticResource ShedsLate}">
                  <TextBlock Text="Accuracy" Style="{StaticResource Head}" Padding="0,0,8,0"
                             ToolTip="Auto-attacks (Attack and Offhand Attack) that connected, out of all attempted. A swing taken by shadows counts as a hit and a Perfect Dodge is not counted. Ranged attacks, weaponskills, job abilities and the pet are not included"/>
                </v:SortHead>
                <v:SortHead Column="crit" Style="{StaticResource ShedsLate}">
                  <TextBlock Text="Crit %" Style="{StaticResource Head}" Padding="0,0,8,0"
                             ToolTip="Auto-attacks (Attack and Offhand Attack) that landed a critical hit, out of those that dealt damage. A swing taken by shadows is not counted. Ranged attacks, weaponskills, job abilities and the pet are not included"/>
                </v:SortHead>
                <v:SortHead Column="delay" Style="{StaticResource ShedsLate}">
                  <TextBlock Text="Delay" Style="{StaticResource Head}" Padding="0,0,8,0"
                             ToolTip="The average time from one round of auto-attacks to the next, in seconds. Weaponskills, job abilities, spells and ranged attacks between two rounds are part of it. Not counted: the time after a target died or was changed, around a death or a pause, or a gap far longer than usual (asleep, stunned, out of range). The pet is not included"/>
                </v:SortHead>
                <v:SortHead Column="rangedAccuracy" Style="{StaticResource Sheds}" AutomationProperties.Name="Ranged accuracy">
                  <TextBlock Text="Acc" Style="{StaticResource Head}" Padding="0,0,8,0"
                             ToolTip="Ranged attacks that connected, out of all attempted. A shot taken by shadows counts as a hit"/>
                </v:SortHead>
                <v:SortHead Column="rangedCrit" Style="{StaticResource Sheds}" AutomationProperties.Name="Ranged crit">
                  <TextBlock Text="Crit %" Style="{StaticResource Head}" Padding="0,0,8,0"
                             ToolTip="Ranged attacks that landed a critical hit, out of those that dealt damage. A shot taken by shadows is not counted"/>
                </v:SortHead>
                <v:SortHead Column="wsDamage" Style="{StaticResource ShedsLate}" AutomationProperties.Name="Weaponskill damage">
                  <TextBlock Text="Damage" Style="{StaticResource Head}" Padding="0,0,8,0"
                             ToolTip="Total weaponskill damage. Skillchain damage is not part of it"/>
                </v:SortHead>
                <v:SortHead Column="wsAvg" Style="{StaticResource ShedsLate}" AutomationProperties.Name="Weaponskill average">
                  <TextBlock Text="Avg" Style="{StaticResource Head}" Padding="0,0,8,0"
                             ToolTip="Average damage of the weaponskills that dealt damage"/>
                </v:SortHead>
                <v:SortHead Column="wsShare" Style="{StaticResource ShedsLate}" AutomationProperties.Name="Weaponskill share">
                  <TextBlock Text="%" Style="{StaticResource Head}" Padding="0,0,8,0"
                             ToolTip="Weaponskill damage out of this character's damage"/>
                </v:SortHead>
                <v:SortHead Column="wsAccuracy" Style="{StaticResource ShedsLate}" AutomationProperties.Name="Weaponskill accuracy">
                  <TextBlock Text="Acc" Style="{StaticResource Head}" Padding="0,0,8,0"
                             ToolTip="Weaponskills that dealt damage, out of all used"/>
                </v:SortHead>
                <v:SortHead Column="scDamage" Style="{StaticResource Sheds}" AutomationProperties.Name="Skillchain damage">
                  <TextBlock Text="Damage" Style="{StaticResource Head}" Padding="0,0,8,0"
                             ToolTip="Total damage of the skillchains this character closed. Empty while Include Skillchains is off"/>
                </v:SortHead>
                <v:SortHead Column="scShare" Style="{StaticResource Sheds}" AutomationProperties.Name="Skillchain share">
                  <TextBlock Text="%" Style="{StaticResource Head}" Padding="0,0,8,0"
                             ToolTip="Skillchain damage out of this character's damage"/>
                </v:SortHead>
                <v:SortHead Column="petDamage" Style="{StaticResource Sheds}" AutomationProperties.Name="Pet damage">
                  <TextBlock Text="Damage" Style="{StaticResource Head}" Padding="0,0,8,0"
                             ToolTip="Everything this character's pet dealt. Already part of Damage"/>
                </v:SortHead>
                <v:SortHead Column="petAccuracy" Style="{StaticResource Sheds}" AutomationProperties.Name="Pet accuracy">
                  <TextBlock Text="Acc" Style="{StaticResource Head}" Padding="0,0,8,0"
                             ToolTip="The pet's melee attacks that connected, out of all attempted"/>
                </v:SortHead>
                <v:SortHead Column="deaths" Style="{StaticResource Sheds}">
                  <TextBlock Text="Deaths" Style="{StaticResource Head}" Padding="0,0,8,0"
                             ToolTip="How many times this character died in the session. The event file says when, and nothing about how long they were down"/>
                </v:SortHead>
              </v:Cells>
              <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>
            </Grid>

            <!-- The rows (ActorLine). A heading is pressed to fold what is
                 under it, a row under one to tick its box; the boxes
                 isolate, and while anything is isolated the rows none of
                 which counts are dimmed, with their own figures. Back to
                 front: the shade and the cells (what dims), the rule, the
                 owner's mark, then what the row wears under the pointer. A rate that is low has its mark under it
                 (v:LowMark); the Damage % has a small bar beside it only
                 while the row is not shaded (v:SmallBar). -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          v:WheelChain.On="True" Focusable="False">
              <Grid>
                <ItemsControl ItemsSource="{Binding Actors}" ItemTemplate="{StaticResource ActorLine}" Focusable="False"
                              Visibility="{Binding OverviewByTarget, Converter={StaticResource Hidden}}"/>
                <ItemsControl ItemsSource="{Binding TargetRows}" ItemTemplate="{StaticResource ActorLine}" Focusable="False"
                              Visibility="{Binding OverviewByTarget, Converter={StaticResource Visible}}"/>
              </Grid>
            </ScrollViewer>

            <!-- The Party line: the party as a whole under the columns it
                 sums, on the raised surface, unshaded and unmarked, with
                 the groups' rules carried through it. It stands still under
                 the rows. Its DPS is the party's, rewritten with the rows'. -->
            <Grid Grid.Row="2" Height="{StaticResource PartyRowHeight}" Background="{DynamicResource Bg2Brush}">
              <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>
              <v:Cells Style="{StaticResource Table}" Margin="0,1,14,0">
                <Border/>
                <Border Visibility="{Binding ShowJob, Converter={StaticResource Visible}}"/>
                <Border/>
                <Border/>
                <Border/>
                <Border Style="{StaticResource ShedsLate}"/>
                <Border Style="{StaticResource ShedsLate}"/>
                <Border Style="{StaticResource ShedsLate}"/>
                <Border v:Cells.Span="2" Style="{StaticResource PartyRuleSheds}"/>
                <Border v:Cells.Span="4" Style="{StaticResource PartyRuleShedsLate}"/>
                <Border v:Cells.Span="2" Style="{StaticResource PartyRuleSheds}"/>
                <Border v:Cells.Span="2" Style="{StaticResource PartyRuleSheds}"/>
                <Border Style="{StaticResource PartyRuleSheds}"/>
              </v:Cells>
              <v:Cells Style="{StaticResource Table}" Margin="0,1,14,0">
                <TextBlock Text="Party" Style="{StaticResource CellText}" Padding="12,0,8,0" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Party.Count}" Style="{StaticResource CellText}" FontSize="11"
                           Foreground="{DynamicResource Text3Brush}" Background="Transparent"
                           ToolTip="The characters listed above"
                           Visibility="{Binding ShowJob, Converter={StaticResource Visible}}"/>
                <TextBlock Text="{Binding Party.Damage}" Style="{StaticResource Cell}" FontWeight="SemiBold" Padding="2,0,8,0"/>
                <TextBlock Text="{Binding Party.Share}" Style="{StaticResource Cell}" Foreground="{DynamicResource Text2Brush}"/>
                <TextBlock Text="{Binding Party.Dps}" Style="{StaticResource Cell}" FontWeight="SemiBold" Padding="2,0,8,0"/>
                <TextBlock Text="{Binding Party.Accuracy}" Style="{StaticResource SubFigShedsLate}"/>
                <TextBlock Text="{Binding Party.Crit}" Style="{StaticResource SubFigShedsLate}"/>
                <!-- No party delay: one average over everyone's weapons describes nobody. -->
                <TextBlock Text="&#x2014;" Style="{StaticResource SubFigShedsLate}"
                           ToolTip="A delay is each character's own"/>
                <TextBlock Text="{Binding Party.RangedAccuracy}" Style="{StaticResource SubFigSheds}"/>
                <TextBlock Text="{Binding Party.RangedCrit}" Style="{StaticResource SubFigSheds}"/>
                <TextBlock Text="{Binding Party.WsDamage}" Style="{StaticResource SubFigShedsLate}" Padding="2,0,8,0"/>
                <TextBlock Text="{Binding Party.WsAvg}" Style="{StaticResource SubFigQuietShedsLate}"/>
                <TextBlock Text="{Binding Party.WsShare}" Style="{StaticResource SubFigQuietShedsLate}"/>
                <TextBlock Text="{Binding Party.WsAccuracy}" Style="{StaticResource SubFigShedsLate}"/>
                <TextBlock Text="{Binding Party.ScDamage}" Style="{StaticResource SubFigSheds}" Padding="2,0,8,0"/>
                <TextBlock Text="{Binding Party.ScShare}" Style="{StaticResource SubFigQuietSheds}"/>
                <TextBlock Text="{Binding Party.PetDamage}" Style="{StaticResource SubFigSheds}" Padding="2,0,8,0"/>
                <TextBlock Text="{Binding Party.PetAccuracy}" Style="{StaticResource SubFigSheds}"/>
                <TextBlock Text="{Binding Party.Deaths}" Style="{StaticResource PartyDeathsFig}"/>
              </v:Cells>
            </Grid>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
  </v:Pane>
</UserControl>
