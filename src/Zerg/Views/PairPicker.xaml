<UserControl x:Class="Zerg.Views.PairPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self" Focusable="False" VerticalAlignment="Center">
  <!-- What one side of a pair is set to, and the way to set it: the side's
       action and a chevron, in one bordered piece as tall as the buttons
       beside it. Its data context is a PairPick. The menu is made of the
       pick's lines each time it opens (PairPicker.xaml.cs): the pair's own
       character's actions in the menu itself, then a line for each other
       character that opens onto theirs. -->
  <UserControl.Resources>
    <ContextMenu x:Key="Menu"/>
  </UserControl.Resources>

  <Button x:Name="Open" Click="OnOpen" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Name}"
          AutomationProperties.HelpText="{Binding Label}" ContextMenuService.IsEnabled="False"
          IsEnabled="{Binding CanPick}" FocusVisualStyle="{StaticResource ZFocus}">
    <Button.Template>
      <ControlTemplate TargetType="Button">
        <Border x:Name="Piece" Height="22" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}"
                Background="Transparent" BorderBrush="{DynamicResource Line2Brush}" Padding="8,0,8,0"
                SnapsToDevicePixels="True">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Picked" Text="{Binding Label}" VerticalAlignment="Center" FontSize="11.5" MaxWidth="220"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text1Brush}"/>
            <Path x:Name="Chevron" Data="M0,0 l3.5,3.5 l3.5,-3.5" StrokeThickness="1.3" StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="8,2,0,0"
                  Stroke="{DynamicResource Text2Brush}"/>
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Piece" Property="Background" Value="{DynamicResource Bg4Brush}"/>
            <Setter TargetName="Piece" Property="BorderBrush" Value="{DynamicResource Line3Brush}"/>
          </Trigger>
          <DataTrigger Binding="{Binding IsOpen, ElementName=Self}" Value="True">
            <Setter TargetName="Piece" Property="Background" Value="{DynamicResource Bg3Brush}"/>
            <Setter TargetName="Piece" Property="BorderBrush" Value="{DynamicResource Line3Brush}"/>
          </DataTrigger>
          <!-- Nothing to choose: the side's action, and no chevron. -->
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="Piece" Property="BorderBrush" Value="Transparent"/>
            <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="Picked" Property="Foreground" Value="{DynamicResource Text2Brush}"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Button.Template>
  </Button>
</UserControl>
