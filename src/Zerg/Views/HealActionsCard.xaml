<UserControl x:Class="Zerg.Views.HealActionsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:v="clr-namespace:Zerg.Views">
  <UserControl.Resources>
    <!-- Heal, Casts, Total, Avg, Min, Max, Share, and a blank column that
         ends the row: the widths the design draws them at in a pane 940
         wide, as shares, each with the least it may be. A narrower pane
         takes the room from the name first; when even the leasts do not
         fit, the table drops Min (v:Shed, on the scroll viewer below).

         There is no "least, average, greatest" mark here, on purpose: Avg
         is per cast and Min and Max are per target, and one line would mix
         the two scales. -->
    <sys:String x:Key="Columns">360*150,56*44,110*64,96*52,96*52,96*52,104*100,8*0</sys:String>

    <!-- The small bar beside a heading's share, in the character's colour:
         in a floating panel, in the colour they have there. -->
    <Style x:Key="HeadingBar" TargetType="v:SmallBar">
      <Setter Property="Fill" Value="{Binding Swatch}"/>
      <Style.Triggers>
        <Trigger Property="v:Float.On" Value="True">
          <Setter Property="Fill" Value="{Binding PanelSwatch}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- A character's heading: who, what their pet healed on top of their
         own (said apart, after the job, because it is not in their total),
         what they healed in all under Total, and their share of the party
         under Share. Shaded in their colour to their healing out of the
         leading healer's. Picking it shows their heals under it; picking it
         again puts them away. By target the heading is a person healed:
         everything that reached them, pets' heals included, and its share
         of everything healed. -->
    <DataTemplate x:Key="Heading">
      <Button Style="{StaticResource RowPick}" Background="{DynamicResource Bg2Brush}"
              Command="{Binding DataContext.ToggleHealsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}"
              ToolTip="Show or hide the lines under it">
        <Grid>
          <Rectangle Margin="0,0,0,1" v:Grow.Share="{Binding Fraction}">
            <Rectangle.Style>
              <Style TargetType="Rectangle" BasedOn="{StaticResource RowShade}">
                <Setter Property="Fill" Value="{Binding Shade}"/>
                <Style.Triggers>
                  <Trigger Property="v:Float.On" Value="True">
                    <Setter Property="Fill" Value="{Binding PanelShade}"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Rectangle.Style>
          </Rectangle>
          <v:Cells Widths="{StaticResource Columns}" Margin="0,0,14,1">
            <DockPanel Margin="12,0,8,0" VerticalAlignment="Center">
              <Path Style="{StaticResource RowCaret}" Margin="0,0,8,0"/>
              <Rectangle Margin="0,0,6,0">
                <Rectangle.Style>
                  <Style TargetType="Rectangle" BasedOn="{StaticResource Swatch}">
                    <Setter Property="Fill" Value="{Binding Swatch}"/>
                    <Style.Triggers>
                      <Trigger Property="v:Float.On" Value="True">
                        <Setter Property="Fill" Value="{Binding PanelSwatch}"/>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </Rectangle.Style>
              </Rectangle>
              <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Job}" Style="{StaticResource Badge}" Foreground="{DynamicResource Text2Brush}"/>
              <!-- The last in the line: it has what is left, and is cut
                   short with an ellipsis when that is not enough. -->
              <TextBlock Text="{Binding Pet}" Style="{StaticResource Badge}" Foreground="{DynamicResource Text2Brush}"
                         FontSize="11" Margin="10,0,0,0" Typography.NumeralAlignment="Tabular"
                         TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <!-- A heading has nothing under Casts, Avg, Min or Max. The
                 blanks hold the columns' places, and the one that goes in a
                 narrow pane goes here too. -->
            <Border/>
            <TextBlock Text="{Binding Total}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
            <Border/>
            <Border Style="{StaticResource Sheds}"/>
            <Border/>
            <v:SmallBar For="Character" Length="42" Value="{Binding Fraction}" Style="{StaticResource HeadingBar}">
              <TextBlock Text="{Binding Share}" Style="{StaticResource Fig}"/>
            </v:SmallBar>
          </v:Cells>
        </Grid>
      </Button>
    </DataTemplate>

    <!-- In a floating panel the drill-down opens under the heal it is about,
         as an action's does in the Actions panel. Made when the heal is
         picked and thrown away when it is not. -->
    <DataTemplate x:Key="Nothing"/>
    <DataTemplate x:Key="Detail">
      <v:DrillCard DataContext="{Binding HealingDrill}" Margin="40,0,0,12" Loaded="OnDetailLoaded"/>
    </DataTemplate>
    <Style x:Key="Under" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="ContentTemplate" Value="{StaticResource Nothing}"/>
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Selected}" Value="True"/>
            <Condition Binding="{Binding Path=(v:Float.On), RelativeSource={RelativeSource Self}}" Value="True"/>
          </MultiDataTrigger.Conditions>
          <Setter Property="ContentTemplate" Value="{StaticResource Detail}"/>
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A person's colour before their name, under a character: in a
         floating panel, the colour they have there. A heal has none, and
         the mark goes (v:Present on the swatch). -->
    <Style x:Key="PersonSwatch" TargetType="Rectangle" BasedOn="{StaticResource Swatch}">
      <Setter Property="Fill" Value="{Binding Swatch}"/>
      <Style.Triggers>
        <Trigger Property="v:Float.On" Value="True">
          <Setter Property="Fill" Value="{Binding PanelSwatch}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- One heal (By spell) or one person healed (By target): its
         figures, and its share as a small bar beside the figure (or as the
         row's own shade, while "shade actions and heals" is on). Picking it
         opens the drill-down and lists the line under it, and the row is
         then on the selected surface with an accent edge at its left;
         picking it again puts both away. -->
    <Style x:Key="ActionPick" TargetType="Button" BasedOn="{StaticResource RowPick}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Selected}" Value="True">
          <Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Side}" Value="B">
          <Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="Action">
      <StackPanel>
        <Button Style="{StaticResource ActionPick}"
                Command="{Binding DataContext.HealDrillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}"
                ToolTip="Show every cast, and the line under it. With Ctrl, set it beside the one open">
          <Grid>
            <Rectangle Style="{StaticResource SubShade}" Margin="0,0,0,1" v:Grow.Share="{Binding ShareFraction}"/>
            <Rectangle Style="{StaticResource ActionEdge}"/>
            <ContentControl Style="{StaticResource RowSideTag}"/>
            <v:Cells Widths="{StaticResource Columns}" Margin="0,0,14,1">
              <!-- The caret stands in the room before the name, which keeps
                   its place under the heading's. -->
              <DockPanel Margin="28,0,8,0" VerticalAlignment="Center">
                <Path Style="{StaticResource RowCaret}" Margin="0,0,6,0"/>
                <Rectangle Style="{StaticResource PersonSwatch}" Margin="0,0,6,0"
                           Visibility="{Binding Swatch, Converter={StaticResource Present}}"/>
                <TextBlock x:Name="Name" Text="{Binding Name}" Style="{StaticResource CellText}" Padding="0"/>
              </DockPanel>
              <TextBlock Text="{Binding Casts}" Style="{StaticResource Cell}"/>
              <TextBlock Text="{Binding Total}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Avg}" Style="{StaticResource Cell}"/>
              <TextBlock Text="{Binding Min}" Style="{StaticResource SubFigQuietSheds}"/>
              <TextBlock Text="{Binding Max}" Style="{StaticResource SubFigQuiet}"/>
              <v:SmallBar For="Action" Length="42" Value="{Binding ShareFraction}" Fill="{DynamicResource Text3Brush}">
                <TextBlock Text="{Binding Share}" Style="{StaticResource Cell}"/>
              </v:SmallBar>
            </v:Cells>
          </Grid>
        </Button>
        <ContentControl Content="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        Style="{StaticResource Under}"/>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Selected}" Value="True">
          <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Side}" Value="B">
          <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The third line, a step under the one it belongs to: a person a heal
         reached (in their colour), or a heal that reached a person. In the
         quieter ink. Picking it opens the drill-down on that one heal on
         that one person; it has nothing under it. -->
    <DataTemplate x:Key="UnderLine">
      <StackPanel>
        <Button Style="{StaticResource ActionPick}"
                Command="{Binding DataContext.HealDrillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}"
                ToolTip="Show every cast of this heal on this person. With Ctrl, set it beside the one open">
          <Grid>
            <Rectangle Style="{StaticResource SubShade}" Margin="0,0,0,1" v:Grow.Share="{Binding ShareFraction}"/>
            <Rectangle Style="{StaticResource ActionEdge}"/>
            <ContentControl Style="{StaticResource RowSideTag}"/>
            <v:Cells Widths="{StaticResource Columns}" Margin="0,0,14,1">
              <DockPanel Margin="56,0,8,0" VerticalAlignment="Center">
                <Rectangle Style="{StaticResource PersonSwatch}" Width="6" Height="6" Margin="0,0,6,0"
                           Visibility="{Binding Swatch, Converter={StaticResource Present}}"/>
                <TextBlock x:Name="Name" Text="{Binding Name}" Style="{StaticResource CellText}" Padding="0"
                           Foreground="{DynamicResource Text2Brush}"/>
              </DockPanel>
              <TextBlock Text="{Binding Casts}" Style="{StaticResource SubFigQuiet}"/>
              <TextBlock Text="{Binding Total}" Style="{StaticResource SubFigQuiet}"/>
              <TextBlock Text="{Binding Avg}" Style="{StaticResource SubFigQuiet}"/>
              <TextBlock Text="{Binding Min}" Style="{StaticResource SubFigQuietSheds}"/>
              <TextBlock Text="{Binding Max}" Style="{StaticResource SubFigQuiet}"/>
              <v:SmallBar For="Action" Length="42" Value="{Binding ShareFraction}" Fill="{DynamicResource Text3Brush}">
                <TextBlock Text="{Binding Share}" Style="{StaticResource SubFigQuiet}"/>
              </v:SmallBar>
            </v:Cells>
          </Grid>
        </Button>
        <ContentControl Content="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        Style="{StaticResource Under}"/>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Selected}" Value="True">
          <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
          <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Text1Brush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Side}" Value="B">
          <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
          <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Text1Brush}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <v:ActionRowTemplates x:Key="Templates" Heading="{StaticResource Heading}" Action="{StaticResource Action}"
                          Under="{StaticResource UnderLine}"/>
  </UserControl.Resources>

  <!-- Every cure, waltz and pet heal, under the character it belongs to, once that
       character's heading is opened (or, By target, under the person it
       healed), three lines deep. A pane: the column headings stand
       still and the rows scroll under them, in whatever height the pane
       has. In a floating panel the list takes the panel's height.

       The pane says how its rows are drawn (v:Shading). The scroll viewer
       says whether there is room for every column (v:Shed.Full): in a pane
       or a panel too narrow for them all, Min goes. Under the least width
       the columns that are left can have, it scrolls sideways. -->
  <v:Pane Title="Heals" Note="{Binding HealsNote}"
          PopOutCommand="{Binding Panels[hactions].PopOutCommand}"
          v:Shading.Characters="{Binding ShadeCharacters}" v:Shading.Actions="{Binding ShadeActions}">
    <!-- The three ways to list the heals: each character, their heals,
         the people each reached; each character, the people they healed,
         the heals on each; or each person healed, who healed them, with
         what. Saved, and the same in a floating panel. -->
    <v:Pane.Tools>
      <Border>
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource SegmentGroup}">
            <Style.Triggers>
              <Trigger Property="v:Float.On" Value="True">
                <Setter Property="Effect" Value="{StaticResource PanelHalo}"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
          <RadioButton Style="{StaticResource Segment}" GroupName="healsBy" Content="By spell"
                       IsChecked="{Binding HealsBy, Converter={StaticResource Equals}, ConverterParameter=Spell}"
                       ToolTip="Each character, their heals, and under a heal the people it reached"
                       AutomationProperties.Name="Heals by spell"/>
          <RadioButton Style="{StaticResource Segment}" GroupName="healsBy" Content="By caster"
                       IsChecked="{Binding HealsBy, Converter={StaticResource Equals}, ConverterParameter=Caster}"
                       ToolTip="Each character, the people they healed, and under a person the heals that reached them"
                       AutomationProperties.Name="Heals by caster"/>
          <RadioButton Style="{StaticResource Segment}" GroupName="healsBy" Content="By target"
                       IsChecked="{Binding HealsBy, Converter={StaticResource Equals}, ConverterParameter=Target}"
                       ToolTip="Each person healed, who healed them, and under a character with what"
                       AutomationProperties.Name="Heals by target"/>
        </StackPanel>
      </Border>
    </v:Pane.Tools>

    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="{Binding HealEmptyText}" Style="{StaticResource Label}" FontSize="12"
                 Margin="0,18,0,8" HorizontalAlignment="Center"
                 Visibility="{Binding HasHeals, Converter={StaticResource Hidden}}"/>

      <ScrollViewer x:Name="Sideways" HorizontalScrollBarVisibility="Auto" v:Shed.Full="{StaticResource Columns}"
                    VerticalScrollBarVisibility="Disabled" v:WheelChain.On="True"
                    Visibility="{Binding HasHeals, Converter={StaticResource Visible}}">
        <Grid MinWidth="476" Width="{Binding ViewportWidth, ElementName=Sideways}">
          <Grid.Style>
            <Style TargetType="Grid">
              <Style.Triggers>
                <!-- Room for the scroll bar a very narrow pane brings. -->
                <DataTrigger Binding="{Binding ComputedHorizontalScrollBarVisibility, ElementName=Sideways}" Value="Visible">
                  <Setter Property="Margin" Value="0,0,0,12"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <!-- 14 units are kept clear at the right of the headings and of
               every row's cells: the room the list's scroll bar is drawn in. -->
          <Grid Height="{StaticResource ColumnHeadHeight}">
            <!-- Each heading orders every character's heals under them
                 (v:SortHead); the characters stay largest first. -->
            <v:Cells Widths="{StaticResource Columns}" Margin="0,0,14,1" v:SortHead.Sort="{Binding HealsSort}">
              <v:SortHead Column="name" Words="True">
                <TextBlock Text="{Binding HealsNameHead}" Style="{StaticResource HeadText}" Padding="12,0,8,0"/>
              </v:SortHead>
              <v:SortHead Column="casts">
                <TextBlock Text="Casts" Style="{StaticResource Head}"
                           ToolTip="One per cast, however many people it reached. On a person, the casts that reached them"/>
              </v:SortHead>
              <v:SortHead Column="total">
                <TextBlock Text="Total" Style="{StaticResource Head}"/>
              </v:SortHead>
              <v:SortHead Column="avg">
                <TextBlock Text="Avg" Style="{StaticResource Head}" ToolTip="Total divided by casts: on a person, what one cast healed them"/>
              </v:SortHead>
              <v:SortHead Column="min" Style="{StaticResource Sheds}">
                <TextBlock Text="Min" Style="{StaticResource Head}"
                           ToolTip="The least one target was healed for, above nothing: a cure on someone at full health is not it"/>
              </v:SortHead>
              <v:SortHead Column="max">
                <TextBlock Text="Max" Style="{StaticResource Head}" ToolTip="The most one target was healed for"/>
              </v:SortHead>
              <v:SortHead Column="share">
                <TextBlock Text="Share" Style="{StaticResource Head}"
                           ToolTip="A heading's: of the party's healing, or By target of everything healed, pets' heals included. A line's: out of everything under its heading, pets' heals included, or a step further in, out of the line it is under"/>
              </v:SortHead>
            </v:Cells>
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>
          </Grid>
          <!-- The rows scroll under their headings, in what the pane or the
               panel has left. In a narrow window, where panes are as tall
               as they ask to be, the list is as tall as it needs, up to
               the cap it had as a card on a page. -->
          <Grid Grid.Row="1">
            <Grid.Style>
              <Style TargetType="Grid">
                <Style.Triggers>
                  <Trigger Property="v:SplitPanel.Stacked" Value="True">
                    <Setter Property="MaxHeight" Value="340"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          v:WheelChain.On="True">
              <ItemsControl x:Name="List" ItemsSource="{Binding Heals}" ItemTemplateSelector="{StaticResource Templates}"
                            Focusable="False"/>
            </ScrollViewer>
          </Grid>
        </Grid>
      </ScrollViewer>
    </DockPanel>
  </v:Pane>
</UserControl>
