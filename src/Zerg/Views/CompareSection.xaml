<UserControl x:Class="Zerg.Views.CompareSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Zerg.Views"
             x:Name="Section"
             v:DeltaCell.NameA="{Binding A.Called}" v:DeltaCell.NameB="{Binding B.Called}">
  <!-- The Compare section's bands: the runs band (the two sides' chips,
       Swap, and Show Damage | Healing), then the band of eight figures;
       while B holds nothing, B's name and the ways to fill it in the panes'
       place. They stand above the panes (Views/ComparePanes) in the main
       window's page, as the band of figures does over the live sections.
       The data context is the CompareViewModel. Numbers and names only: no
       notes. -->
  <UserControl.Resources>

    <!-- A side's chip: its letter, its name (edited in place with F2 or the
         pencil), its file and length, LIVE while it is the live session.
         Pressed (or Enter, or Alt+Down), its picker opens under it. A file
         dropped on it is taken into that side. -->
    <Style x:Key="Chip" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource ZFocus}"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Foreground" Value="{DynamicResource Text1Brush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" CornerRadius="{DynamicResource ControlRadius}" BorderThickness="1" Padding="6,0,10,0"
                    Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource Line2Brush}" SnapsToDevicePixels="True">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Bg3Brush}"/>
              </Trigger>
              <DataTrigger Binding="{Binding Picking}" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Bg3Brush}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsOver}" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource DropZoneFillBrush}"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A line of a picker: a dot for the source in use, the source, and
         at the right only a length, "replay", a date, an extension, or
         the other side's letter where it is that side's already. -->
    <Style x:Key="PickLine" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Foreground" Value="{DynamicResource Text1Brush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" CornerRadius="4" Background="Transparent" Padding="10,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Bg4Brush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Bg4Brush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Text4Brush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PickRule" TargetType="Rectangle">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Margin" Value="4,3"/>
      <Setter Property="Fill" Value="{DynamicResource Line2Brush}"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- LIVE, on a chip and on a picker's line. -->
    <Style x:Key="LiveTag" TargetType="Border">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LiveBrush}"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <DataTemplate x:Key="Option">
      <Button Style="{StaticResource PickLine}" Command="{Binding Command}" AutomationProperties.Name="{Binding Label}">
        <DockPanel>
          <Ellipse DockPanel.Dock="Left" Width="12" Height="12" StrokeThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Stroke" Value="{DynamicResource Line3Brush}"/>
                <Setter Property="Fill" Value="Transparent"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Chosen}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock DockPanel.Dock="Right" Margin="18,0,0,0" FontSize="11" VerticalAlignment="Center"
                     Foreground="{DynamicResource Text3Brush}" Typography.NumeralAlignment="Tabular">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="{Binding Note}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Text" Value="{Binding Mark}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="Side">
      <Grid AllowDrop="True" DragEnter="OnSlotDrag" DragOver="OnSlotDrag" DragLeave="OnSlotLeave" Drop="OnSlotDrop"
            Background="Transparent">
        <Button x:Name="ChipButton" Style="{StaticResource Chip}" Command="{Binding PickCommand}"
                AutomationProperties.Name="{Binding Called}" KeyboardNavigation.IsTabStop="True">
          <Button.InputBindings>
            <KeyBinding Key="F2" Command="{Binding RenameCommand}"/>
            <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding PickCommand}"/>
          </Button.InputBindings>
          <StackPanel Orientation="Horizontal">
            <Control>
              <Control.Style>
                <Style TargetType="Control" BasedOn="{StaticResource RunTag}">
                  <Setter Property="Template" Value="{StaticResource RunTagB}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsA}" Value="True">
                      <Setter Property="Template" Value="{StaticResource RunTagA}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Control.Style>
            </Control>
            <TextBlock Text="{Binding Called}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding Renaming, Converter={StaticResource Hidden}}"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="22" Margin="8,0,0,0"
                     FontSize="12.5" VerticalContentAlignment="Center" AutomationProperties.Name="Run name"
                     Visibility="{Binding Renaming, Converter={StaticResource Visible}}"
                     IsVisibleChanged="OnNameShown" KeyDown="OnNameKey" LostKeyboardFocus="OnNameLeft"/>
            <TextBlock Text="{Binding ScopeText}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentBrush}"/>
            <Button Style="{StaticResource IconButton}" Command="{Binding RenameCommand}" Width="20" Height="20" Margin="4,0,0,0"
                    Focusable="False" ToolTip="Rename (F2)" AutomationProperties.Name="Rename">
              <TextBlock Text="&#x270E;" FontSize="11" Foreground="{DynamicResource Text3Brush}"/>
            </Button>
            <Path Data="M0,0 L3.5,3.5 L7,0" Width="7" Height="4" StrokeThickness="1.3" Margin="4,1,0,0" VerticalAlignment="Center"
                  Stroke="{DynamicResource Text3Brush}"/>
            <Border Style="{StaticResource LiveTag}" Margin="8,0,0,0" Visibility="{Binding IsLive, Converter={StaticResource Visible}}">
              <TextBlock Text="LIVE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource LiveBrush}" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding File}" Style="{StaticResource Mono}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Text2Brush}" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Length}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Text3Brush}" Typography.NumeralAlignment="Tabular"/>
            <TextBlock Text="{Binding Error}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="260"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource CritBrush}"/>
          </StackPanel>
        </Button>

        <!-- The picker: the name first (focused, selected), the sources,
             then the scope. Esc or a press elsewhere shuts it. -->
        <Popup IsOpen="{Binding Picking, Mode=TwoWay}" StaysOpen="False" Placement="Bottom" AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=ChipButton}" VerticalOffset="4" Opened="OnPickerOpened">
          <Border Width="360" Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource Line3Brush}"
                  BorderThickness="1" CornerRadius="8" Padding="4,4,4,6" PreviewKeyDown="OnPickerKey"
                  TextElement.FontFamily="{DynamicResource TextFont}" TextElement.Foreground="{DynamicResource Text1Brush}">
            <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle">
              <DockPanel Height="30" Margin="10,0">
                <TextBlock Text="Name" Width="42" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Text3Brush}"/>
                <TextBox x:Name="PickName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="24"
                         VerticalContentAlignment="Center" AutomationProperties.Name="Run name"/>
              </DockPanel>
              <Rectangle Style="{StaticResource PickRule}"/>
              <ItemsControl ItemsSource="{Binding Options}" ItemTemplate="{StaticResource Option}" Focusable="False"/>
              <Rectangle Style="{StaticResource PickRule}"/>
              <StackPanel Orientation="Horizontal" Margin="10,4,10,0">
                <Border Style="{StaticResource SegmentGroup}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" Content="Whole party" IsChecked="{Binding Whole}"
                                 AutomationProperties.Name="Whole party"/>
                    <RadioButton Style="{StaticResource Segment}" Content="One character" IsChecked="{Binding One}"
                                 IsEnabled="{Binding HasRun}" AutomationProperties.Name="One character"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Characters}" Focusable="False" Margin="6,4,6,0"
                            Visibility="{Binding One, Converter={StaticResource Visible}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource GhostButton}" Content="{Binding}" Height="22" Padding="8,0" FontSize="11.5"
                            Margin="4,2,0,0"
                            Command="{Binding DataContext.ScopeToCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>
    </DataTemplate>

    <!-- A figure of the band: what it is, B's figure, the change at the
         right in its tone, and A's figure under it in A's colour. -->
    <DataTemplate x:Key="BandCell">
      <Grid Height="64" Background="Transparent" AutomationProperties.Name="{Binding Label}">
        <Rectangle x:Name="Rule" Width="1" HorizontalAlignment="Left" Margin="0,10" Fill="{DynamicResource Line2Brush}"
                   SnapsToDevicePixels="True"/>
        <v:Caps Text="{Binding Label}" Style="{StaticResource Caps}" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="14,7,14,0"/>
        <DockPanel Margin="14,17,14,0" VerticalAlignment="Top">
          <TextBlock DockPanel.Dock="Right" Text="{Binding Cell.Change.Main}" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="8,4,0,0" Typography.NumeralAlignment="Tabular">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Cell.Change.Tone}" Value="Better">
                    <Setter Property="Foreground" Value="{DynamicResource LiveBrush}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Cell.Change.Tone}" Value="Worse">
                    <Setter Property="Foreground" Value="{DynamicResource CritBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding Cell.B}" Style="{StaticResource TileFigure}" FontSize="22" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <TextBlock Text="{Binding Cell.A}" FontSize="10.5" Margin="14,45,14,0" VerticalAlignment="Top"
                   Foreground="{DynamicResource RunATextBrush}" TextTrimming="CharacterEllipsis"
                   Typography.NumeralAlignment="Tabular"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                     Value="0">
          <Setter TargetName="Rule" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="EmptyOption">
      <Border Height="34" Margin="0,0,0,6" Padding="12,0" CornerRadius="4" BorderThickness="1"
              BorderBrush="{DynamicResource Line2Brush}" Background="{DynamicResource Bg2Brush}">
        <DockPanel>
          <Control DockPanel.Dock="Left" Style="{StaticResource RunTag}" Template="{StaticResource RunTagB}"/>
          <Button DockPanel.Dock="Right" Content="Use" Command="{Binding Command}" Height="22" Padding="10,0"
                  AutomationProperties.Name="{Binding Label, StringFormat='Use {0}'}"/>
          <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Note}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource Text3Brush}" Typography.NumeralAlignment="Tabular"/>
        </DockPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel Background="{DynamicResource Bg1Brush}">

    <!-- The runs band: A's chip, Swap, B's chip; Show at the right. One tab
         group: chips, Swap and Show. -->
    <DockPanel Margin="10,5,10,5" KeyboardNavigation.TabNavigation="Local">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
        <TextBlock Text="Show" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Border Style="{StaticResource SegmentGroup}">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource Segment}" GroupName="compareMode" Content="Damage" TabIndex="3"
                         IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Damage}"
                         AutomationProperties.Name="Compare damage"/>
            <RadioButton Style="{StaticResource Segment}" GroupName="compareMode" Content="Healing" TabIndex="4"
                         IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Healing}"
                         AutomationProperties.Name="Compare healing"/>
          </StackPanel>
        </Border>
      </StackPanel>
      <WrapPanel VerticalAlignment="Center">
        <ContentControl Content="{Binding A}" ContentTemplate="{StaticResource Side}" Focusable="False" Margin="0,2,8,2"
                        TabIndex="0"/>
        <Button Style="{StaticResource GhostButton}" Height="24" Padding="8,0" FontSize="11.5" Content="&#x21C4; Swap"
                Command="{Binding SwapCommand}" Margin="0,2,8,2" TabIndex="1" ToolTip="Ctrl+Shift+S"
                AutomationProperties.Name="Swap the runs"/>
        <ContentControl Content="{Binding B}" ContentTemplate="{StaticResource Side}" Focusable="False" Margin="0,2,0,2"
                        TabIndex="2"/>
      </WrapPanel>
    </DockPanel>
    <Rectangle Height="1" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>

    <!-- Eight figures, two across in a narrow window. -->
    <ItemsControl ItemsSource="{Binding Band}" ItemTemplate="{StaticResource BandCell}" Focusable="False" AlternationCount="64"
                  Visibility="{Binding ShowsPanes, Converter={StaticResource Visible}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="{Binding BandColumns, ElementName=Section}"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
    <Rectangle Height="1" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"
               Visibility="{Binding ShowsPanes, Converter={StaticResource Visible}}"/>

    <!-- B holds nothing: its name, and the two quickest ways to fill it. -->
    <Grid MinHeight="240" Visibility="{Binding ShowsEmpty, Converter={StaticResource Visible}}">
      <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,32">
        <TextBlock Text="{Binding B.Called}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <ItemsControl ItemsSource="{Binding EmptyOptions}" ItemTemplate="{StaticResource EmptyOption}" Focusable="False"/>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
