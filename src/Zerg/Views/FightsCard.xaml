<UserControl x:Class="Zerg.Views.FightsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:z="clr-namespace:Zerg"
             xmlns:v="clr-namespace:Zerg.Views">
  <UserControl.Resources>
    <!-- When, the monster, Kill time, Damage, DPS: each figure column wide
         enough for its longest figure or its heading. A narrower pane takes
         the room from the name first; when even the leasts do not fit, DPS
         goes (v:Shed, on the table below). -->
    <sys:String x:Key="Columns">52*48,170*110,68*60,84*64,68*56</sys:String>

    <!-- The row is the bar, as in By target beside it: shaded from its left
         edge to its kill time out of the longest's, so a slow kill stands
         out. No character's colour: a kill is the party's. -->
    <Style x:Key="Shade" TargetType="Rectangle" BasedOn="{StaticResource RowShade}">
      <Setter Property="Fill" Value="{DynamicResource ActionShadeBrush}"/>
      <Setter Property="Margin" Value="0,0,0,1"/>
    </Style>
    <Style x:Key="Pick" TargetType="Button" BasedOn="{StaticResource SidePick}">
      <Setter Property="Height" Value="{StaticResource SubRowHeight}"/>
    </Style>
    <!-- The clock at the kill: quieter than the figures, read down the edge. -->
    <Style x:Key="When" TargetType="TextBlock" BasedOn="{StaticResource FigQuiet}">
      <Setter Property="Padding" Value="0,0,8,0"/>
    </Style>

    <!-- One kill: when, the monster with its code (one life of one spawn:
         a code, never a count), how long it took, what the party dealt it
         and over how long. Pressed, it isolates that fight; isolated, it has
         the accent down its left edge, and the rows that are not are dimmed,
         as a side table's are. -->
    <DataTemplate DataType="{x:Type z:FightRow}">
      <Button Style="{StaticResource Pick}" AutomationProperties.Name="{Binding Pressed}">
        <Grid>
          <Grid Style="{StaticResource PickCells}">
            <Rectangle Style="{StaticResource Shade}" v:Grow.Share="{Binding Fraction}"/>
            <v:Cells Widths="{StaticResource Columns}" Margin="0,0,14,1">
              <TextBlock Text="{Binding When}" Style="{StaticResource When}"/>
              <TextBlock Style="{StaticResource PickName}">
                <Run Text="{Binding Name, Mode=OneWay}"/>
                <Run Text="{Binding Code, Mode=OneWay}" Foreground="{DynamicResource Text3Brush}"/>
              </TextBlock>
              <TextBlock Text="{Binding KillTime}" Style="{StaticResource Fig}" FontWeight="SemiBold" Padding="2,0,8,0"/>
              <TextBlock Text="{Binding Damage}" Style="{StaticResource Fig}" Padding="2,0,8,0"/>
              <TextBlock Text="{Binding Dps}" Style="{StaticResource FigQuietSheds}" Padding="2,0,8,0"/>
            </v:Cells>
          </Grid>
          <Rectangle Style="{StaticResource PickEdge}"/>
        </Grid>
      </Button>
    </DataTemplate>

    <!-- One of the party who died, between the kills around it: who, in
         Crit. The event file says nothing more, so neither does the line. -->
    <DataTemplate DataType="{x:Type z:DeathRow}">
      <Border Height="{StaticResource SubRowHeight}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
              Background="Transparent" ToolTip="{Binding Tip}" SnapsToDevicePixels="True">
        <v:Cells Widths="{StaticResource Columns}" Margin="0,0,14,0">
          <TextBlock Text="{Binding When}" Style="{StaticResource When}"/>
          <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" Padding="14,0,8,0" v:Cells.Span="4"
                     Foreground="{DynamicResource CritBrush}"/>
        </v:Cells>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <!-- The Fights pane: every kill of the session, newest first, each one
       life of one spawn ("Tiger [00B]"), with the party's deaths between
       them; under the list the kills together. The column headings stand
       still and the rows scroll under them; the line of totals stands
       still under the rows. Nothing in it moves with the clock: a fight is
       listed once its death line is read, and never changes after. -->
  <v:Pane Title="Fights" Note="{Binding FightsNote}"
          Hint="Every kill of the session, newest first, with the party's deaths between them. Select a kill to count only that fight"
          PopOutCommand="{Binding Panels[fights].PopOutCommand}"
          v:Shading.Characters="{Binding ShadeCharacters}">
    <v:Pane.Tools>
      <Button Content="Clear" Command="{Binding ClearFightCommand}" ToolTip="Let the fight go: count every fight again"
              AutomationProperties.Name="Clear the fight"
              Visibility="{Binding FightIsolated, Converter={StaticResource Visible}}">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Style.Triggers>
              <Trigger Property="v:Float.On" Value="True">
                <Setter Property="Margin" Value="0,3,22,1"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
    </v:Pane.Tools>
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="No kills yet" Style="{StaticResource Label}" FontSize="12"
                 Margin="12,18,12,8" HorizontalAlignment="Center"
                 Visibility="{Binding HasFights, Converter={StaticResource Hidden}}"/>

      <Grid v:Shed.Full="{StaticResource Columns}" Visibility="{Binding HasFights, Converter={StaticResource Visible}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Height="{StaticResource SubRowHeight}">
          <v:Cells Widths="{StaticResource Columns}" Margin="0,0,14,1">
            <TextBlock Text="When" Style="{StaticResource Head}" Padding="0,0,8,0"
                       ToolTip="The session clock at the killing blow"/>
            <TextBlock Text="Target" Style="{StaticResource HeadText}" Padding="14,0,8,0"
                       ToolTip="The monster, and its code as the target bar shows it: the last three digits of its id in hexadecimal. The same code again is the same spawn point, respawned"/>
            <TextBlock Text="Kill time" Style="{StaticResource Head}" Padding="2,0,8,0"
                       ToolTip="From the party's first action at it to its death"/>
            <TextBlock Text="Damage" Style="{StaticResource Head}" Padding="2,0,8,0"
                       ToolTip="What the characters who count dealt it"/>
            <TextBlock Text="DPS" Style="{StaticResource HeadSheds}" Padding="2,0,8,0"
                       ToolTip="Its damage over its kill time: the party's pace on that monster. It stands while a target is isolated: the fight's length is known"/>
          </v:Cells>
          <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>
        </Grid>
        <Grid Grid.Row="1" Style="{StaticResource SideList}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" v:WheelChain.On="True">
            <ItemsControl ItemsSource="{Binding Fights}" Focusable="False"/>
          </ScrollViewer>
        </Grid>
        <!-- The kills together, on the raised surface, as a Party line is. -->
        <Grid Grid.Row="2" Height="{StaticResource SubRowHeight}" Background="{DynamicResource Bg2Brush}"
              ToolTip="{Binding FightsTip}">
          <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>
          <v:Cells Widths="{StaticResource Columns}" Margin="0,1,14,0">
            <Border/>
            <TextBlock Text="{Binding FightsCount}" Style="{StaticResource CellText}" Padding="14,0,8,0"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{Binding FightsKillTime}" Style="{StaticResource SubFig}" FontWeight="SemiBold" Padding="2,0,8,0"/>
            <TextBlock Text="{Binding FightsDamage}" Style="{StaticResource SubFig}" Padding="2,0,8,0"/>
            <TextBlock Text="{Binding FightsDps}" Style="{StaticResource SubFigQuietSheds}" Padding="2,0,8,0"/>
          </v:Cells>
        </Grid>
      </Grid>
    </DockPanel>
  </v:Pane>
</UserControl>
